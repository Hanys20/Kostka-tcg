---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "KOSTKA TCG – herna pro hráče, od hráčů pro hráče. Turnaje a ligy Lorcana, Pokémon a Riftbound v Ostravě." } = Astro.props;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/logo-icon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · KOSTKA TCG</title>
    <script is:inline>
      (function () {
        const STORAGE_KEY = "kostka-theme";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const toggle = document.getElementById("theme-toggle");

        function getSystemTheme() {
          return media.matches ? "dark" : "light";
        }

        function applyTheme(mode) {
          const resolved = mode === "light" || mode === "dark" ? mode : getSystemTheme();
          root.setAttribute("data-theme", resolved);
          root.dataset.themeMode = resolved;

          if (toggle) {
            const isDark = resolved === "dark";
            toggle.setAttribute("aria-label", isDark ? "Přepnout do světlého motivu" : "Přepnout do tmavého motivu");
            const sunIcon = toggle.querySelector("[data-icon='sun']");
            const moonIcon = toggle.querySelector("[data-icon='moon']");
            if (sunIcon) sunIcon.classList.toggle("hidden", !isDark);
            if (moonIcon) moonIcon.classList.toggle("hidden", isDark);
          }
        }

        const saved = localStorage.getItem(STORAGE_KEY) || "dark";
        applyTheme(saved);

        if (toggle) {
          toggle.addEventListener("click", () => {
            const current = root.getAttribute("data-theme") === "light" ? "light" : "dark";
            const next = current === "dark" ? "light" : "dark";
            localStorage.setItem(STORAGE_KEY, next);
            applyTheme(next);
          });
        }

        media.addEventListener("change", () => {
          const savedTheme = localStorage.getItem(STORAGE_KEY);
          if (!savedTheme || savedTheme === "auto") {
            applyTheme("auto");
          }
        });
      })();
    </script>
  </head>
  <body id="top" class="bg-kostka-bg text-kostka-white">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-kostka-bg/90 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo-full-white.svg" alt="KOSTKA TCG" class="logo-header-dark h-12 w-auto" />
          <img src="/images/logo-full.svg" alt="KOSTKA TCG" class="logo-header-light hidden h-12 w-auto" />
        </a>
        <ul class="hidden items-center gap-7 text-xs font-semibold uppercase tracking-wide md:flex">
          <li><a href="/turnaje" class="text-white/70 hover:text-kostka-purple">Kalendář</a></li>
          <li><a href="/faq" class="text-white/70 hover:text-kostka-purple">FAQ</a></li>
          <li><a href="/kontakt" class="text-white/70 hover:text-kostka-purple">Kontakt</a></li>
        </ul>
        <div class="flex items-center gap-2 sm:gap-3">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Přepnout motiv"
            class="hidden h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-kostka-purple transition hover:border-kostka-purple hover:bg-kostka-purple/10 lg:grid"
          >
            <svg data-icon="sun" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v2.2"></path>
              <path d="M12 18.8V21"></path>
              <path d="M4.93 4.93l1.56 1.56"></path>
              <path d="M17.51 17.51l1.56 1.56"></path>
              <path d="M3 12h2.2"></path>
              <path d="M18.8 12H21"></path>
              <path d="M4.93 19.07l1.56-1.56"></path>
              <path d="M17.51 6.49l1.56-1.56"></path>
              <circle cx="12" cy="12" r="4.2"></circle>
            </svg>
            <svg data-icon="moon" viewBox="0 0 24 24" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.4 14.7A8.4 8.4 0 0 1 9.3 3.6a8.6 8.6 0 1 0 11.1 11.1Z"></path>
            </svg>
          </button>

          <div class="hidden items-center gap-2 lg:flex">
            <a
              href="https://www.facebook.com/profile.php?id=61593014467767"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="KOSTKA TCG na Facebooku"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-kostka-purple hover:bg-kostka-purple/10 hover:text-kostka-purple"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.87.24-1.46 1.5-1.46h1.6V4.35C15.9 4.24 15.03 4.17 14 4.17c-2.13 0-3.6 1.3-3.6 3.68v2.05H7.8v3h2.6V21h3.1Z"></path>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/kostkatcg/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="KOSTKA TCG na Instagramu"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-kostka-purple hover:bg-kostka-purple/10 hover:text-kostka-purple"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
                <circle cx="12" cy="12" r="3.7"></circle>
                <circle cx="16.85" cy="7.15" r="0.9" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          </div>

          <div class="hidden items-center rounded-full border border-white/15 bg-white/5 p-1 lg:flex">
            <button
              type="button"
              data-lang-option="cs"
              class="lang-option rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/70 transition hover:text-kostka-purple"
            >
              CZ
            </button>
            <button
              type="button"
              data-lang-option="en"
              class="lang-option rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/70 transition hover:text-kostka-purple"
            >
              EN
            </button>
          </div>

          <a
            href="/turnaje"
            class="rounded-full bg-kostka-purple px-5 py-2 text-xs font-semibold uppercase tracking-wide text-kostka-bg hover:opacity-90"
          >
            Zarezervuj termín
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        const THEME_STORAGE_KEY = "kostka-theme";
        const LANGUAGE_STORAGE_KEY = "kostka-language";
        const toggle = document.getElementById("theme-toggle");
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        function getSystemTheme() {
          return media.matches ? "dark" : "light";
        }

        function applyTheme(mode) {
          const resolved = mode === "light" || mode === "dark" ? mode : getSystemTheme();
          root.setAttribute("data-theme", resolved);
          root.dataset.themeMode = resolved;

          if (toggle) {
            const isDark = resolved === "dark";
            toggle.setAttribute("aria-label", isDark ? "Přepnout do světlého motivu" : "Přepnout do tmavého motivu");
            const sunIcon = toggle.querySelector("[data-icon='sun']");
            const moonIcon = toggle.querySelector("[data-icon='moon']");
            if (sunIcon) sunIcon.classList.toggle("hidden", !isDark);
            if (moonIcon) moonIcon.classList.toggle("hidden", isDark);
          }
        }

        function applyLanguage(lang) {
          const resolvedLang = lang === "en" ? "en" : "cs";
          root.setAttribute("lang", resolvedLang);
          root.dataset.lang = resolvedLang;

          const langButtons = document.querySelectorAll("[data-lang-option]");
          langButtons.forEach((button) => {
            const isActive = button.getAttribute("data-lang-option") === resolvedLang;
            button.classList.toggle("bg-kostka-purple", isActive);
            button.classList.toggle("text-kostka-bg", isActive);
            button.classList.toggle("text-white/70", !isActive);
          });
        }

        const savedTheme = localStorage.getItem(THEME_STORAGE_KEY) || "dark";
        const savedLanguage = localStorage.getItem(LANGUAGE_STORAGE_KEY) || "cs";

        applyTheme(savedTheme);
        applyLanguage(savedLanguage);

        if (toggle) {
          toggle.addEventListener("click", () => {
            const current = root.getAttribute("data-theme") === "light" ? "light" : "dark";
            const next = current === "dark" ? "light" : "dark";
            localStorage.setItem(THEME_STORAGE_KEY, next);
            applyTheme(next);
          });
        }

        document.querySelectorAll("[data-lang-option]").forEach((button) => {
          button.addEventListener("click", () => {
            const lang = button.getAttribute("data-lang-option") || "cs";
            localStorage.setItem(LANGUAGE_STORAGE_KEY, lang);
            applyLanguage(lang);
          });
        });

        media.addEventListener("change", () => {
          const stored = localStorage.getItem(THEME_STORAGE_KEY);
          if (!stored || stored === "auto") {
            applyTheme("auto");
          }
        });
      })();
    </script>

    <a
      href="#top"
      aria-label="Zpět nahoru"
      class="fixed bottom-6 right-6 z-40 grid h-11 w-11 place-items-center rounded-full border border-white/10 bg-kostka-surface text-kostka-purple shadow-lg shadow-black/40 hover:bg-kostka-purple hover:text-kostka-bg"
    >
      ↑
    </a>

    <footer class="mt-24 border-t border-white/10 bg-kostka-surface">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <img src="/images/logo-full-white.svg" alt="KOSTKA TCG" class="logo-footer-dark h-9 w-auto" />
          <img src="/images/logo-full.svg" alt="KOSTKA TCG" class="logo-footer-light hidden h-9 w-auto" />
          <p class="mt-4 text-sm text-white/60">Dolní 782/65</p>
          <p class="text-sm text-white/60">700 30 Ostrava-Jih-Zábřeh</p>
          <p class="mt-3 text-sm">
            <a href="tel:+420773334488" class="text-white/60 hover:text-kostka-purple">+420 773 334 488</a>
          </p>
          <p class="text-sm">
            <a href="mailto:info@kostkatcg.cz" class="text-white/60 hover:text-kostka-purple">info@kostkatcg.cz</a>
          </p>
          <div class="mt-4 flex items-center gap-3">
            <a
              href="https://www.facebook.com/profile.php?id=61593014467767"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="KOSTKA TCG na Facebooku"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-kostka-purple hover:bg-kostka-purple/10 hover:text-kostka-purple"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.87.24-1.46 1.5-1.46h1.6V4.35C15.9 4.24 15.03 4.17 14 4.17c-2.13 0-3.6 1.3-3.6 3.68v2.05H7.8v3h2.6V21h3.1Z"></path>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/kostkatcg/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="KOSTKA TCG na Instagramu"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-kostka-purple hover:bg-kostka-purple/10 hover:text-kostka-purple"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
                <circle cx="12" cy="12" r="3.7"></circle>
                <circle cx="16.85" cy="7.15" r="0.9" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-kostka-purple">Navigace</p>
          <ul class="mt-4 space-y-2 text-sm text-white/60">
            <li><a href="/turnaje" class="hover:text-kostka-purple">Kalendář</a></li>
            <li><a href="/faq" class="hover:text-kostka-purple">FAQ</a></li>
            <li><a href="/kontakt" class="hover:text-kostka-purple">Kontakt</a></li>
          </ul>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-kostka-purple">Právní informace</p>
          <ul class="mt-4 space-y-2 text-sm text-white/60">
            <li><a href="/gdpr" class="hover:text-kostka-purple">GDPR</a></li>
            <li><a href="/gdpr" class="hover:text-kostka-purple">Zásady ochrany osobních údajů</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-4 py-5 text-xs text-white/40">
          © {new Date().getFullYear()} KOSTKA TCG. Všechna práva vyhrazena.
        </div>
      </div>
    </footer>
  </body>
</html>
