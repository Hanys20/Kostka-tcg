---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kontakt">
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-black text-kostka-dark md:text-4xl">Kontakt</h1>
    <dl class="mt-8 space-y-3 text-kostka-dark/80">
      <div>
        <dt class="font-semibold text-kostka-dark">Pobočka</dt>
        <dd>Dolní 782/65, 700 30 Ostrava-Jih-Zábřeh</dd>
      </div>
      <div>
        <dt class="font-semibold text-kostka-dark">E-mail</dt>
        <dd><a class="hover:text-kostka-cyan" href="mailto:info@kostkatcg.cz">info@kostkatcg.cz</a></dd>
      </div>
      <div>
        <dt class="font-semibold text-kostka-dark">Telefon</dt>
        <dd><a class="hover:text-kostka-cyan" href="tel:+420773334488">+420 773 334 488</a></dd>
      </div>
    </dl>
    <p class="mt-8 text-kostka-dark/60">Mapa bude doplněna.</p>
  </section>
</Layout>
