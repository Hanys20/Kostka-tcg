---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Stránka nebyla nalezena">
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-4 py-16 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-kostka-cyan">Placeholder</p>
    <h1 class="mt-3 text-4xl font-black text-white md:text-5xl">Tahle stránka zatím neexistuje.</h1>
    <p class="mt-4 text-base text-white/60">
      Tento odkaz byl přesunut do záchytného placeholderu, aby návštěvník vždy mohl pokračovat dál.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-kostka-cyan px-6 py-3 text-sm font-semibold text-kostka-bg hover:opacity-90">Domů</a>
      <a href="/turnaje" class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white hover:border-kostka-cyan hover:text-kostka-cyan">Turnaje</a>
      <a href="/kontakt" class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white hover:border-kostka-cyan hover:text-kostka-cyan">Kontakt</a>
    </div>
  </section>
</Layout>
