---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "Jak zarezervuji místo na turnaji?",
    a: "Na stránce Turnaje vyberte termín a odešlete rezervaci – stačí jméno, e-mail a nick, přihlášení uživatelé mají údaje předvyplněné.",
  },
  {
    q: "Musím platit předem?",
    a: "Ne, účastnický poplatek se platí až na místě před začátkem turnaje.",
  },
];
---

<Layout title="FAQ">
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-black text-kostka-dark md:text-4xl">Časté dotazy</h1>
    <div class="mt-8 divide-y divide-kostka-dark/10">
      {
        faqs.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold text-kostka-dark marker:content-none">
              {item.q}
            </summary>
            <p class="mt-2 text-kostka-dark/70">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Layout>
