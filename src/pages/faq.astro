---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "Jak zarezervuji místo na turnaji?",
    a: "Na stránce Turnaje vyberte termín a odešlete rezervaci – stačí jméno, e-mail a nick. Přihlášení uživatelé mají údaje předvyplněné z účtu.",
  },
  {
    q: "Musím mít účet, abych se mohl zúčastnit?",
    a: "Ne, rezervace funguje i jako host. Účet se hodí, pokud chcete mít přehled o historii výsledků a umístění.",
  },
  {
    q: "Musím platit předem?",
    a: "Ne, účastnický poplatek se platí až na místě před začátkem turnaje. Online platby zatím nenabízíme.",
  },
  {
    q: "Jaký je rozdíl mezi ligou a turnajem?",
    a: "Liga se hraje pravidelně (každý týden), turnaje a prerelease akce jsou jednorázové.",
  },
  {
    q: "Jaké hry u vás můžu hrát a nakupovat?",
    a: "Zaměřujeme se na Lorcana, Pokémon a Riftbound – karty, boostery i doplňky.",
  },
  {
    q: "Proč zvolit zrovna KOSTKA TCG?",
    a: "Lepší ceny, osobní přístup a přátelská atmosféra – jsme herna od hráčů pro hráče, ne anonymní obchod.",
  },
];
---

<Layout title="FAQ">
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-black text-kostka-dark md:text-4xl">Časté dotazy</h1>
    <div class="mt-8 divide-y divide-kostka-dark/10">
      {
        faqs.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold text-kostka-dark marker:content-none">
              {item.q}
            </summary>
            <p class="mt-2 text-kostka-dark/70">{item.a}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-10 text-kostka-dark/60">
      Nenašli jste odpověď? <a href="/kontakt" class="font-semibold text-kostka-cyan hover:underline">Napište nám</a>.
    </p>
  </section>
</Layout>
