---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Riftbound | KOSTKA TCG">
  <section class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <div class="overflow-hidden rounded-3xl border border-white/10 bg-transparent p-4 md:p-6">
      <img
        src="/images/games/riftbound.png"
        alt="Riftbound logo"
        class="w-full max-w-2xl bg-transparent object-contain"
      />
    </div>

    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-kostka-cyan">Hra</p>
    <h1 class="mt-3 text-4xl font-black uppercase text-white md:text-5xl">Riftbound</h1>
    <p class="mt-5 max-w-2xl text-white/65">
      Riftbound přináší do herny nový zážitek s rychlým tempem a komunitou, která se ráda schází
      pravidelně na turnajích a probíhajících ligách.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/turnaje" class="rounded-full bg-kostka-cyan px-6 py-3 text-sm font-semibold uppercase tracking-wide text-kostka-bg">Zobrazit termíny</a>
      <a href="/kontakt" class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white">Kontaktovat nás</a>
    </div>
  </section>
</Layout>
