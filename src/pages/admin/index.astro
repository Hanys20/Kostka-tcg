---
import Layout from "../../layouts/Layout.astro";
import { getAdminSession } from "../../lib/adminAuth";

export const prerender = false;

const session = await getAdminSession(Astro.cookies);
const isLoggedIn = !!session;
const isPrimary = session?.isPrimary ?? false;
const nickname = session?.nickname ?? "";
---

<Layout title="Administrace">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:py-16">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-black text-white sm:text-3xl md:text-4xl">Administrace turnajů</h1>
        <p class="mt-2 text-sm text-white/60 sm:text-base">
          Správa termínů turnajů a lig – napojeno na Supabase.
        </p>
      </div>
      <div class:list={["flex items-center gap-3", { hidden: !isLoggedIn }]} id="logged-in-bar">
        <span class="text-sm text-white/60">Přihlášen jako <strong class="text-white">{nickname}</strong></span>
        <button id="logout-button" type="button" class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white hover:border-kostka-purple hover:text-kostka-purple">
          Odhlásit se
        </button>
      </div>
    </div>

    <div id="auth-card" class:list={["mx-auto mt-8 max-w-md rounded-2xl border border-white/10 bg-kostka-surface p-6", { hidden: isLoggedIn }]}>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-purple">Přihlášení</p>
      <h2 class="mt-2 text-2xl font-bold text-white">Admin login</h2>
      <form id="login-form" class="mt-6 space-y-3">
        <input id="admin-nick" type="text" autocomplete="username" placeholder="Přezdívka" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" required />
        <input id="admin-password" type="password" autocomplete="current-password" placeholder="Heslo" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" required />
        <button id="login-submit-button" type="submit" class="w-full rounded-full bg-kostka-purple px-5 py-2.5 text-sm font-semibold text-kostka-bg hover:opacity-90">
          Přihlásit se
        </button>
      </form>
      <p id="login-message" class="mt-3 text-sm text-red-300"></p>
    </div>

    <div id="admin-panel" class:list={["", { hidden: !isLoggedIn }]}>
      <div class="mt-8 grid gap-8 lg:grid-cols-[420px_1fr]">
        <div class="rounded-2xl border border-white/10 bg-kostka-surface p-5">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-purple">Přidat / upravit</p>
              <h2 id="form-heading" class="mt-2 text-xl font-bold text-white">Turnaj / liga</h2>
            </div>
            <button id="cancel-edit-button" type="button" class="hidden rounded-full border border-white/15 px-3 py-1.5 text-xs font-semibold text-white/70 hover:border-kostka-purple hover:text-kostka-purple">
              Zrušit úpravu
            </button>
          </div>
          <form id="event-form" class="mt-4 space-y-3">
            <div class="rounded-xl border border-kostka-purple/20 bg-kostka-purple/10 p-3">
              <label for="playhub-url" class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-purple">Import z PlayHubu</label>
              <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                <input id="playhub-url" type="url" placeholder="https://tcg.ravensburgerplay.com/events/638126" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" />
                <button id="import-playhub-button" type="button" class="w-full rounded-full border border-kostka-purple/40 px-3 py-2 text-sm font-semibold text-kostka-purple hover:bg-kostka-purple/10 sm:w-auto">Načíst</button>
              </div>
              <p id="playhub-message" class="mt-2 text-xs text-white/50">Vložte odkaz na event a předvyplníme datum, čas, obsazenost a cenu.</p>
            </div>
            <input id="event-title" type="text" placeholder="Název události" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" required />
            <select id="event-type" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-purple">
              <option value="tournament">Turnaj</option>
              <option value="league">Liga</option>
            </select>
            <select id="event-game" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-purple">
              <option value="Lorcana">Lorcana</option>
              <option value="Pokémon">Pokémon</option>
              <option value="Riftbound">Riftbound</option>
            </select>
            <input id="event-date" type="date" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-purple" required />
            <div class="grid gap-3 sm:grid-cols-2">
              <input id="event-start" type="time" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-purple" required />
              <input id="event-end" type="time" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-purple" required />
            </div>
            <input id="event-capacity" type="number" min="1" placeholder="Kapacita (celkový počet míst)" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" required />
            <input id="event-spots-taken" type="number" min="0" placeholder="Počet registrovaných hráčů" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" />
            <input id="event-price" type="text" placeholder="Cena za turnaj (volitelné)" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" />
            <input id="event-url" type="url" placeholder="Registrace / odkaz na stránku hry (volitelné)" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" />
            <button id="submit-event-button" type="submit" class="w-full rounded-full bg-kostka-purple px-5 py-2.5 text-sm font-semibold text-kostka-bg hover:opacity-90">
              Uložit událost
            </button>
          </form>
          <p id="admin-message" class="mt-3 text-sm text-kostka-purple"></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-kostka-surface p-5">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-purple">Seznam událostí</p>
              <h2 class="mt-2 text-xl font-bold text-white">Nadcházející a proběhlé termíny</h2>
            </div>
          </div>

          <div id="event-list" class="mt-4 grid gap-3 sm:grid-cols-2">
            <p id="event-list-empty" class="text-sm text-white/50">Načítám události…</p>
          </div>
        </div>
      </div>

      {isPrimary && (
        <div class="mt-10 rounded-2xl border border-white/10 bg-kostka-surface p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-purple">Primární admin</p>
          <h2 class="mt-2 text-xl font-bold text-white">Správa administrátorů</h2>
          <p class="mt-2 text-sm text-white/50">
            Tuhle sekci vidí jen primární admin. Přidávejte a spravujte účty dalších adminů.
          </p>

          <form id="admin-account-form" class="mt-4 grid gap-3 sm:grid-cols-2">
            <input id="admin-account-nickname" type="text" placeholder="Přezdívka" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" required />
            <input id="admin-account-email" type="email" placeholder="E-mail" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple" required />
            <input id="admin-account-password" type="password" autocomplete="new-password" placeholder="Heslo (min. 8 znaků)" minlength="8" class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-purple sm:col-span-2" required />
            <button id="admin-account-submit" type="submit" class="w-full rounded-full bg-kostka-purple px-5 py-2.5 text-sm font-semibold text-kostka-bg hover:opacity-90 sm:col-span-2">
              Přidat admina
            </button>
          </form>
          <p id="admin-account-message" class="mt-3 text-sm text-kostka-purple"></p>

          <div id="admin-account-list" class="mt-6 grid gap-3 sm:grid-cols-2">
            <p class="text-sm text-white/50">Načítám adminy…</p>
          </div>
        </div>
      )}
    </div>
  </section>

  <script is:inline define:vars={{ isLoggedIn, isPrimary }}>
    const loginForm = document.getElementById("login-form");
    const loginSubmitButton = document.getElementById("login-submit-button");
    const loginMessage = document.getElementById("login-message");
    const logoutButton = document.getElementById("logout-button");
    const eventForm = document.getElementById("event-form");
    const adminMessage = document.getElementById("admin-message");
    const eventList = document.getElementById("event-list");
    const playhubUrlInput = document.getElementById("playhub-url");
    const importPlayhubButton = document.getElementById("import-playhub-button");
    const playhubMessage = document.getElementById("playhub-message");
    const formHeading = document.getElementById("form-heading");
    const submitEventButton = document.getElementById("submit-event-button");
    const cancelEditButton = document.getElementById("cancel-edit-button");

    let currentEvents = [];
    let editingId = null;

    function formatDate(isoDate) {
      return new Date(isoDate).toLocaleDateString("cs-CZ", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
      });
    }

    function statusLabel(status) {
      if (status === "cancelled") return "Zrušeno";
      if (status === "past") return "Proběhlo";
      return "Nadcházející";
    }

    function reloadOnAuthError(response) {
      if (response.status === 401) {
        window.location.reload();
        return true;
      }
      return false;
    }

    async function loadEvents() {
      eventList.innerHTML = `<p class="text-sm text-white/50">Načítám události…</p>`;
      try {
        const response = await fetch("/api/admin/events");
        if (reloadOnAuthError(response)) return;
        const result = await response.json();
        if (response.ok && result.ok) {
          currentEvents = result.events || [];
          renderEvents();
        } else {
          eventList.innerHTML = `<p class="text-sm text-red-300">${result.message || "Nepodařilo se načíst události."}</p>`;
        }
      } catch {
        eventList.innerHTML = `<p class="text-sm text-red-300">Nepodařilo se načíst události ze Supabase.</p>`;
      }
    }

    function renderEvents() {
      if (!currentEvents.length) {
        eventList.innerHTML = `<p class="text-sm text-white/50">Zatím žádné události. Přidej první vlevo.</p>`;
        return;
      }

      eventList.innerHTML = currentEvents
        .map(
          (event) => `
        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold text-white">${event.title}</p>
              <p class="mt-1 text-xs text-white/50">${event.type === "league" ? "Liga" : "Turnaj"} · ${event.game}</p>
            </div>
            ${event.registration_url ? `<a href="${event.registration_url}" class="shrink-0 text-xs font-semibold text-kostka-purple hover:underline" target="_blank" rel="noreferrer">Odkaz</a>` : ""}
          </div>
          <p class="mt-3 text-sm text-white/70">${formatDate(event.starts_at)}</p>
          <p class="mt-1 text-sm text-white/70">${event.spots_taken ?? 0}/${event.capacity ?? "?"} míst · ${statusLabel(event.status)}</p>
          <div class="mt-3 flex items-center gap-4 border-t border-white/10 pt-3">
            <button type="button" data-edit-id="${event.id}" class="text-sm font-semibold text-white/70 hover:text-kostka-purple">Upravit</button>
            <button type="button" data-delete-id="${event.id}" class="text-sm font-semibold text-red-300 hover:text-red-200">Smazat</button>
          </div>
        </div>
      `
        )
        .join("");
    }

    eventList.addEventListener("click", async (event) => {
      const editButton = event.target.closest("[data-edit-id]");
      if (editButton) {
        const item = currentEvents.find((e) => e.id === editButton.dataset.editId);
        if (item) startEdit(item);
        return;
      }

      const deleteButton = event.target.closest("[data-delete-id]");
      if (deleteButton) {
        const id = deleteButton.dataset.deleteId;
        const item = currentEvents.find((e) => e.id === id);
        if (!confirm(`Opravdu smazat událost „${item ? item.title : ""}“? Tuto akci nelze vrátit zpět.`)) return;

        try {
          const response = await fetch("/api/admin/events", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id }),
          });
          if (reloadOnAuthError(response)) return;
          const result = await response.json();
          if (response.ok && result.ok) {
            if (editingId === id) resetForm();
            await loadEvents();
            adminMessage.textContent = "Událost byla smazána.";
          } else {
            adminMessage.textContent = result.message || "Smazání se nepodařilo.";
          }
        } catch {
          adminMessage.textContent = "Smazání se nepodařilo – zkontroluj připojení.";
        }
      }
    });

    function startEdit(item) {
      editingId = item.id;
      const startsAt = new Date(item.starts_at);
      const pad = (n) => String(n).padStart(2, "0");
      document.getElementById("event-date").value = `${startsAt.getUTCFullYear()}-${pad(startsAt.getUTCMonth() + 1)}-${pad(startsAt.getUTCDate())}`;
      document.getElementById("event-start").value = `${pad(startsAt.getUTCHours())}:${pad(startsAt.getUTCMinutes())}`;
      const endMatch = (item.description || "").match(/(\d{1,2}:\d{2})\s*[–-]\s*(\d{1,2}:\d{2})/);
      document.getElementById("event-end").value = endMatch ? endMatch[2] : document.getElementById("event-start").value;
      document.getElementById("event-title").value = item.title || "";
      document.getElementById("event-type").value = item.type;
      document.getElementById("event-game").value = item.game;
      document.getElementById("event-capacity").value = item.capacity ?? "";
      document.getElementById("event-spots-taken").value = item.spots_taken ?? 0;
      document.getElementById("event-price").value = item.price || "";
      document.getElementById("event-url").value = item.registration_url || "";
      playhubUrlInput.value = "";
      playhubMessage.textContent = "Úprava existující události – import z PlayHubu přepíše obsazenost a cenu.";

      formHeading.textContent = `Upravit: ${item.title}`;
      submitEventButton.textContent = "Uložit změny";
      cancelEditButton.classList.remove("hidden");
      adminMessage.textContent = "";
      document.getElementById("event-title").scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function resetForm() {
      editingId = null;
      eventForm.reset();
      formHeading.textContent = "Turnaj / liga";
      submitEventButton.textContent = "Uložit událost";
      cancelEditButton.classList.add("hidden");
      playhubMessage.textContent = "Vložte odkaz na event a předvyplníme datum, čas, obsazenost a cenu.";
    }

    cancelEditButton.addEventListener("click", () => resetForm());

    function inferGameFromTitle(title) {
      if (!title) return "Lorcana";
      const normalized = title.toLowerCase();
      if (normalized.includes("pokemon")) return "Pokémon";
      if (normalized.includes("riftbound")) return "Riftbound";
      return "Lorcana";
    }

    importPlayhubButton.addEventListener("click", async () => {
      const url = playhubUrlInput.value.trim();
      if (!url) {
        playhubMessage.textContent = "Vložte odkaz na event z PlayHubu.";
        return;
      }

      importPlayhubButton.disabled = true;
      playhubMessage.textContent = "Načítám data z PlayHubu…";

      try {
        const response = await fetch("/api/admin/playhub-import", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url }),
        });
        if (reloadOnAuthError(response)) return;
        const result = await response.json();

        if (response.ok && result.ok) {
          const data = result.data;
          document.getElementById("event-title").value = data.title || "";
          document.getElementById("event-date").value = data.date || "";
          document.getElementById("event-start").value = data.startTime || "";
          document.getElementById("event-end").value = data.endTime || "";
          document.getElementById("event-capacity").value = data.spotsTotal ? String(data.spotsTotal) : "";
          document.getElementById("event-spots-taken").value = data.spotsTaken != null ? String(data.spotsTaken) : "0";
          document.getElementById("event-price").value = data.price && data.currency ? `${data.price} ${data.currency}` : (data.price || "");
          document.getElementById("event-url").value = url;
          document.getElementById("event-type").value = "tournament";
          document.getElementById("event-game").value = data.game || inferGameFromTitle(data.title);
          playhubMessage.textContent = `Data načtena: ${data.title} (${data.spotsTaken ?? "?"}/${data.spotsTotal ?? "?"} míst)`;
        } else {
          playhubMessage.textContent = result.message || "Nepodařilo se načíst data.";
        }
      } catch {
        playhubMessage.textContent = "Nepodařilo se načíst data z PlayHubu.";
      } finally {
        importPlayhubButton.disabled = false;
      }
    });

    loginForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const nick = document.getElementById("admin-nick").value.trim();
      const password = document.getElementById("admin-password").value;

      loginMessage.textContent = "";
      loginSubmitButton.disabled = true;
      try {
        const response = await fetch("/api/admin/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nick, password }),
        });
        const result = await response.json();
        if (response.ok && result.ok) {
          window.location.reload();
        } else {
          loginMessage.textContent = result.message || "Špatná přezdívka nebo heslo.";
        }
      } catch {
        loginMessage.textContent = "Přihlášení se nepodařilo – zkontroluj připojení.";
      } finally {
        loginSubmitButton.disabled = false;
      }
    });

    if (logoutButton) {
      logoutButton.addEventListener("click", async () => {
        logoutButton.disabled = true;
        await fetch("/api/admin/logout", { method: "POST" }).catch(() => {});
        window.location.reload();
      });
    }

    eventForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const title = document.getElementById("event-title").value.trim();
      const type = document.getElementById("event-type").value;
      const game = document.getElementById("event-game").value;
      const date = document.getElementById("event-date").value;
      const startTime = document.getElementById("event-start").value;
      const endTime = document.getElementById("event-end").value;
      const capacity = Number(document.getElementById("event-capacity").value);
      const spotsTaken = Number(document.getElementById("event-spots-taken").value) || 0;
      const price = document.getElementById("event-price").value.trim();
      const customUrl = document.getElementById("event-url").value.trim();
      const registrationUrl = customUrl || null;

      const payload = {
        title,
        type,
        game,
        date,
        startTime,
        endTime,
        capacity,
        registrationUrl,
        price: price || null,
        spotsTaken,
      };

      submitEventButton.disabled = true;
      try {
        const response = await fetch("/api/admin/events", {
          method: editingId ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(editingId ? { ...payload, id: editingId } : payload),
        });
        if (reloadOnAuthError(response)) return;

        const result = await response.json();

        if (response.ok && result.ok) {
          adminMessage.textContent = editingId ? "Změny byly uloženy." : "Událost byla uložena do Supabase.";
          resetForm();
          await loadEvents();
        } else {
          adminMessage.textContent = result.message || "Uložení se nepodařilo.";
        }
      } catch {
        adminMessage.textContent = "Uložení se nepodařilo – zkontroluj připojení k Supabase.";
      } finally {
        submitEventButton.disabled = false;
      }
    });

    // --- Správa adminů (jen primární admin) ---
    const adminAccountForm = document.getElementById("admin-account-form");
    const adminAccountList = document.getElementById("admin-account-list");
    const adminAccountMessage = document.getElementById("admin-account-message");
    const adminAccountSubmit = document.getElementById("admin-account-submit");

    async function loadAdminAccounts() {
      if (!adminAccountList) return;
      adminAccountList.innerHTML = `<p class="text-sm text-white/50">Načítám adminy…</p>`;
      try {
        const response = await fetch("/api/admin/admins");
        if (reloadOnAuthError(response)) return;
        const result = await response.json();
        if (response.ok && result.ok) {
          renderAdminAccounts(result.admins || []);
        } else {
          adminAccountList.innerHTML = `<p class="text-sm text-red-300">${result.message || "Nepodařilo se načíst adminy."}</p>`;
        }
      } catch {
        adminAccountList.innerHTML = `<p class="text-sm text-red-300">Nepodařilo se načíst adminy.</p>`;
      }
    }

    function renderAdminAccounts(admins) {
      if (!admins.length) {
        adminAccountList.innerHTML = `<p class="text-sm text-white/50">Zatím žádní další admini.</p>`;
        return;
      }

      adminAccountList.innerHTML = admins
        .map(
          (admin) => `
        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold text-white">${admin.nickname}${admin.isPrimary ? ' <span class="ml-1 rounded-full bg-kostka-purple/20 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-kostka-purple">Primární</span>' : ""}</p>
              <p class="mt-1 text-xs text-white/50">${admin.email}</p>
            </div>
          </div>
          <div class="mt-3 flex items-center gap-4 border-t border-white/10 pt-3">
            <button type="button" data-admin-edit="${admin.id}" class="text-sm font-semibold text-white/70 hover:text-kostka-purple">Upravit</button>
            ${admin.isPrimary ? "" : `<button type="button" data-admin-delete="${admin.id}" class="text-sm font-semibold text-red-300 hover:text-red-200">Smazat</button>`}
          </div>
        </div>
      `
        )
        .join("");
    }

    if (adminAccountList) {
      adminAccountList.addEventListener("click", async (event) => {
        const editButton = event.target.closest("[data-admin-edit]");
        if (editButton) {
          const id = editButton.dataset.adminEdit;
          const newNickname = prompt("Nová přezdívka (nech prázdné pro beze změny):");
          const newEmail = prompt("Nový e-mail (nech prázdné pro beze změny):");
          const newPassword = prompt("Nové heslo, min. 8 znaků (nech prázdné pro beze změny):");

          const payload = { id };
          if (newNickname) payload.nickname = newNickname.trim();
          if (newEmail) payload.email = newEmail.trim();
          if (newPassword) payload.password = newPassword;

          if (!payload.nickname && !payload.email && !payload.password) return;

          try {
            const response = await fetch("/api/admin/admins", {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            if (reloadOnAuthError(response)) return;
            const result = await response.json();
            if (response.ok && result.ok) {
              adminAccountMessage.textContent = "Účet byl upraven.";
              await loadAdminAccounts();
            } else {
              adminAccountMessage.textContent = result.message || "Úprava se nepodařila.";
            }
          } catch {
            adminAccountMessage.textContent = "Úprava se nepodařila – zkontroluj připojení.";
          }
          return;
        }

        const deleteButton = event.target.closest("[data-admin-delete]");
        if (deleteButton) {
          const id = deleteButton.dataset.adminDelete;
          if (!confirm("Opravdu smazat tento admin účet? Tuto akci nelze vrátit zpět.")) return;

          try {
            const response = await fetch("/api/admin/admins", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id }),
            });
            if (reloadOnAuthError(response)) return;
            const result = await response.json();
            if (response.ok && result.ok) {
              adminAccountMessage.textContent = "Admin byl smazán.";
              await loadAdminAccounts();
            } else {
              adminAccountMessage.textContent = result.message || "Smazání se nepodařilo.";
            }
          } catch {
            adminAccountMessage.textContent = "Smazání se nepodařilo – zkontroluj připojení.";
          }
        }
      });
    }

    if (adminAccountForm) {
      adminAccountForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const nickname = document.getElementById("admin-account-nickname").value.trim();
        const email = document.getElementById("admin-account-email").value.trim();
        const password = document.getElementById("admin-account-password").value;

        adminAccountSubmit.disabled = true;
        try {
          const response = await fetch("/api/admin/admins", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nickname, email, password }),
          });
          if (reloadOnAuthError(response)) return;
          const result = await response.json();
          if (response.ok && result.ok) {
            adminAccountMessage.textContent = "Nový admin byl vytvořen.";
            adminAccountForm.reset();
            await loadAdminAccounts();
          } else {
            adminAccountMessage.textContent = result.message || "Vytvoření se nepodařilo.";
          }
        } catch {
          adminAccountMessage.textContent = "Vytvoření se nepodařilo – zkontroluj připojení.";
        } finally {
          adminAccountSubmit.disabled = false;
        }
      });
    }

    if (isLoggedIn) {
      loadEvents();
      if (isPrimary) loadAdminAccounts();
    }
  </script>
</Layout>
