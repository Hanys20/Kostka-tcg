---
import { getAdminSession } from "../../lib/adminAuth";

export const prerender = false;

const session = await getAdminSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/admin?next=/admin/maraton");
}
---

<!--
  Maraton deskových her – bodování (Tabule) + živý Leaderboard na projektor.
  Převzato z prototypu (claude.ai artifact). Záměrně vlastní design v barvách
  tyrkysové kostky Klubu deskových her, mimo hlavní Layout webu.
  Stav je v localStorage (kostka-maraton-v1); okna Tabule a Leaderboardu ve
  stejném prohlížeči se propojují přes BroadcastChannel + storage event.
-->
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Maraton her · Kostka</title>
    <link rel="icon" type="image/png" href="/images/maraton/kostka-tyrkys.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:inline>

/* ============ base.css ============ */
:root{
  --brand:#00BBD6;
  --brand-600:#00A0BC;
  --brand-700:#005F73;
  --brand-050:#d4f3f8;

  --gold:#FFC24B;
  --silver:#CBD7DD;
  --bronze:#E08A4B;

  --ink:#020d10;
  --ink-soft:#1e353b;
  --line:#a9bfc5;
  --bg:#e9f0f2;
  --card:#ffffff;

  --ok:#0B7A4B;
  --danger:#B02A15;

  --radius:14px;
  --shadow-sm:0 1px 2px rgba(12,31,36,.06), 0 2px 8px rgba(12,31,36,.05);
  --shadow-md:0 6px 24px rgba(12,31,36,.12);

  --font-head:'Oswald', 'Bebas Neue', 'Arial Narrow', system-ui, sans-serif;
  --font-body:'Barlow', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;

  color-scheme:light;
}

*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;padding:0}
html{font-size:16px}
body{
  font-family:var(--font-body);
  font-size:1rem;
  color:var(--ink);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
h1,h2,h3,h4{font-family:var(--font-head);font-weight:600;margin:0;letter-spacing:.01em}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
button{cursor:pointer}
a{color:var(--brand-700)}

.headline{text-transform:uppercase;letter-spacing:.06em}
.tnum{font-family:var(--font-head);font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}

.btn{
  display:inline-flex;align-items:center;gap:.5rem;justify-content:center;
  border:1px solid var(--line);background:var(--card);color:var(--ink);
  padding:.55rem .9rem;border-radius:10px;font-weight:600;line-height:1;
  transition:background .12s ease, border-color .12s ease, transform .06s ease;
}
.btn:hover{background:#f7fafb}
.btn:active{transform:translateY(1px)}
.btn--primary{background:var(--brand);border-color:var(--brand-700);color:#00171c}
.btn--primary:hover{background:var(--brand-600);border-color:var(--brand-600)}
.btn--ghost{background:transparent;border-color:transparent}
.btn--ghost:hover{background:rgba(12,31,36,.06)}
.btn--danger{color:var(--danger);border-color:#d98f83}
.btn--danger:hover{background:#fdf1ef}
.btn--sm{padding:.4rem .6rem;border-radius:8px;font-size:.9rem}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{
  outline:2px solid var(--brand);outline-offset:2px}

.chip{
  display:inline-flex;align-items:center;gap:.4rem;
  padding:.25rem .6rem;border-radius:999px;font-size:.8rem;font-weight:600;
  background:var(--brand-050);color:var(--brand-700);
}

.modal-backdrop{
  position:fixed;inset:0;background:rgba(9,22,26,.55);
  display:flex;align-items:center;justify-content:center;padding:1.5rem;z-index:50;
  opacity:0;pointer-events:none;transition:opacity .16s ease;
}
.modal-backdrop.open{opacity:1;pointer-events:auto}
.modal{
  background:var(--card);border-radius:16px;box-shadow:var(--shadow-md);
  width:min(560px,100%);max-height:88vh;overflow:auto;transform:translateY(8px) scale(.98);
  transition:transform .16s ease;
}
.modal-backdrop.open .modal{transform:none}
.modal h3{font-size:1.3rem;text-transform:uppercase;letter-spacing:.04em}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.3rem;border-bottom:1px solid var(--line)}
.modal-body{padding:1.3rem}
.modal-foot{padding:1rem 1.3rem;border-top:1px solid var(--line);display:flex;gap:.6rem;justify-content:flex-end}

.field{display:flex;flex-direction:column;gap:.35rem;margin-bottom:1rem}
.field label{font-weight:600;font-size:.85rem;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.04em}
.field input,.field select,.field textarea{
  border:1px solid var(--line);border-radius:9px;padding:.6rem .7rem;background:#fff;
}
.field input:focus,.field select:focus,.field textarea:focus{outline:2px solid var(--brand);outline-offset:0;border-color:var(--brand)}
.field-row{display:flex;gap:.8rem}
.field-row .field{flex:1}

.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);border:0}

/* ============ view switch ============ */
#view-launch,#view-admin,#view-board{display:none}
body.launch-mode #view-launch{display:block}
body.admin-mode  #view-admin {display:block}
body.lb-mode     #view-board {display:block}

body.launch-mode{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(1200px 700px at 70% -10%, #12313a 0%, #061114 55%, #030909 100%);
}

/* ============ launcher (rozcestník) ============ */
.launch{width:min(880px,92vw);text-align:center;color:#fff;padding:2rem}
.launch .brandmark{width:96px;margin:0 auto 1.2rem;display:block}
.launch h1{font-size:clamp(2.6rem,7vw,4.6rem);line-height:.92;text-transform:uppercase;letter-spacing:.02em;text-wrap:balance}
.launch h1 span{color:var(--brand)}
.launch .sub{font-family:var(--font-head);text-transform:uppercase;letter-spacing:.35em;
  font-size:clamp(.9rem,2.2vw,1.2rem);color:#d2ecf1;margin:.4rem 0 2.4rem}
.launch .cards{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem}
@media(max-width:640px){.launch .cards{grid-template-columns:1fr}}
.launch .pick{
  display:block;text-decoration:none;color:#fff;text-align:left;
  background:rgba(255,255,255,.09);border:2px solid rgba(255,255,255,.32);
  border-radius:18px;padding:1.5rem 1.4rem;transition:transform .12s ease, background .12s ease, border-color .12s;
}
.launch .pick:hover{transform:translateY(-3px);background:rgba(0,187,214,.18);border-color:var(--brand)}
.launch .pick .k{font-family:var(--font-head);text-transform:uppercase;letter-spacing:.08em;font-size:1.5rem}
.launch .pick .d{color:#e1f1f4;margin-top:.4rem;font-size:.95rem;line-height:1.4}
.launch .pick .ico{font-size:1.8rem}
.launch .foot{margin-top:2rem;color:#c3dde2;font-size:.85rem;line-height:1.6}
.launch kbd{background:rgba(255,255,255,.2);border-radius:5px;padding:.1rem .4rem;font-family:var(--font-head)}

/* ============ admin.css (Tabule) ============ */
.app{max-width:1220px;margin:0 auto;padding:1rem 1.2rem 4rem}

.top{display:flex;align-items:center;gap:1rem;padding:.6rem 0 1rem;flex-wrap:wrap}
.top .mark{width:44px;height:44px;flex:none}
.top .title{font-family:var(--font-head);text-transform:uppercase;line-height:1;letter-spacing:.03em}
.top .title b{font-size:1.5rem;display:block;font-weight:700}
.top .title span{font-size:.8rem;color:var(--ink-soft);letter-spacing:.22em}
.top .spacer{flex:1}
.top .status{display:flex;align-items:center;gap:.45rem;font-size:.82rem;color:var(--ink-soft)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px rgba(31,169,113,.18)}
.dot.remote{background:var(--brand);box-shadow:0 0 0 3px rgba(0,187,214,.18)}
.dot.saving{background:var(--gold);box-shadow:0 0 0 3px rgba(255,194,75,.3)}
.dot.offline{background:var(--danger);box-shadow:0 0 0 3px rgba(176,42,21,.2)}
.top .status.warn{color:var(--danger);font-weight:700}

#btnRace{font-family:var(--font-head);font-weight:700;letter-spacing:.02em;font-variant-numeric:tabular-nums;white-space:nowrap}
#btnRace.race-live{background:#0c1f24;border-color:#0c1f24;color:#fff}
#btnRace.race-live::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--brand);
  box-shadow:0 0 0 3px rgba(0,187,214,.3);animation:pulse 1.4s ease-in-out infinite}
#btnRace.race-done{background:var(--gold);border-color:var(--gold);color:#3a2c05}
@keyframes pulse{50%{opacity:.35}}

.toolbar{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem}
.toolbar .spacer{flex:1}
.toolbar .search{position:relative}
.toolbar .search input{border:1px solid var(--line);border-radius:10px;padding:.55rem .8rem .55rem 2rem;min-width:200px;background:#fff}
.toolbar .search::before{content:"⌕";position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:var(--ink-soft)}

.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin-bottom:1.1rem}
@media(max-width:720px){.summary{grid-template-columns:repeat(2,1fr)}}
.stat{background:var(--card);border:1px solid var(--line);color:var(--ink);border-radius:12px;padding:.7rem .9rem}
.stat .n{font-family:var(--font-head);font-size:1.6rem;font-weight:700;line-height:1}
.stat .l{font-size:.75rem;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.06em;margin-top:.2rem}

.table-wrap{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:auto}
table.grid{border-collapse:collapse;width:100%;min-width:920px}
.grid thead th{
  position:sticky;top:0;z-index:2;background:#fff;
  font-family:var(--font-head);text-transform:uppercase;letter-spacing:.05em;font-size:.72rem;color:var(--ink-soft);
  font-weight:600;text-align:left;padding:.7rem .6rem;border-bottom:2px solid var(--line);white-space:nowrap;
}
.grid tbody td{padding:.45rem .6rem;border-bottom:1px solid var(--line);vertical-align:middle}
.grid tbody tr:hover{background:#f8fbfc}
.grid tbody tr.flash{animation:rowflash 1s ease}
@keyframes rowflash{0%{background:rgba(0,187,214,.22)}100%{background:transparent}}

.col-rank{width:44px;text-align:center;color:var(--ink-soft);font-family:var(--font-head);font-weight:700}
.rank-medal{color:var(--brand-700)}
.col-total{width:76px}

.grid th.col-rank,.grid td.col-rank{position:sticky;left:0;z-index:3;background:#fff}
.grid th.col-name,.grid td.col-name{position:sticky;left:44px;z-index:3;background:#fff;
  box-shadow:6px 0 8px -6px rgba(12,31,36,.12)}
.grid thead th.col-rank,.grid thead th.col-name{z-index:4}
.grid tbody tr:hover td.col-rank,.grid tbody tr:hover td.col-name{background:#f8fbfc}
.grid tbody tr.flash td.col-rank,.grid tbody tr.flash td.col-name{background:transparent}
.total-badge{font-family:var(--font-head);font-weight:700;font-size:1.15rem;background:var(--brand-050);color:var(--brand-700);
  border-radius:8px;padding:.2rem .5rem;display:inline-block;min-width:2.6ch;text-align:center}

.name-cell{display:flex;align-items:center;gap:.55rem;min-width:180px}
.name-main{font-weight:600}
.name-sub{font-size:.75rem;color:var(--ink-soft)}
.name-toggle{border:1px solid var(--line);background:#fff;border-radius:999px;font-size:.68rem;
  text-transform:uppercase;letter-spacing:.04em;padding:.12rem .5rem;color:var(--ink-soft)}
.name-toggle:hover{border-color:var(--brand);color:var(--brand-700)}
.paid-box{display:flex;align-items:center;justify-content:center}
.paid-box input{width:18px;height:18px;accent-color:var(--brand)}

.stepper{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:9px;overflow:hidden;background:#fff}
.stepper button{border:0;background:#fff;width:30px;height:30px;font-size:1.1rem;font-weight:700;color:var(--brand-700);line-height:1}
.stepper button:hover{background:var(--brand-050)}
.stepper button:disabled{color:#8fa3a9}
.stepper .v{min-width:2.4ch;text-align:center;font-family:var(--font-head);font-weight:700;font-size:1rem;padding:0 .2rem}
.stepper.mini button{width:26px;height:26px;font-size:.95rem}
.stepper.mini .v{font-size:.9rem;min-width:1.8ch}

.places{display:flex;gap:.35rem}
.place-unit{display:flex;flex-direction:column;align-items:center;gap:.15rem}
.place-unit .cap{font-size:.7rem}

.tasks-cell{min-width:172px}
.task-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:4px}
.task-grid .tk{
  width:24px;height:24px;border:1px solid var(--line);border-radius:6px;background:#fff;
  font-family:var(--font-head);font-weight:700;font-size:.8rem;color:var(--ink-soft);
  display:flex;align-items:center;justify-content:center;transition:background .1s,border-color .1s,color .1s;
}
.task-grid .tk:hover{border-color:var(--brand)}
.task-grid .tk.done{background:var(--brand);border-color:var(--brand-700);color:#00171c}
.task-count{display:inline-block;margin-top:.35rem;font-size:.72rem;color:var(--ink-soft);font-weight:600}
.task-count b{font-family:var(--font-head);color:var(--brand-700)}

.tiers-cell{min-width:360px}
table.tiers{border-collapse:collapse}
table.tiers th,table.tiers td{padding:1px 3px;text-align:center}
table.tiers thead th{font-size:.64rem;text-transform:uppercase;letter-spacing:.03em;color:var(--ink-soft);font-weight:700}
table.tiers tbody th{font-family:var(--font-head);font-weight:700;font-size:.72rem;color:var(--ink);text-align:right;padding-right:.4rem;white-space:nowrap}
table.tiers .tier-play .v{color:var(--brand-700)}

.manual-btn{border:1px dashed var(--line);background:#fff;border-radius:8px;padding:.32rem .55rem;font-weight:600;color:var(--ink-soft);font-size:.85rem}
.manual-btn:hover{border-color:var(--brand);color:var(--brand-700)}
.manual-btn.has{border-style:solid;color:var(--brand-700);background:var(--brand-050)}

.row-menu{position:relative}
.row-menu .dots{border:0;background:transparent;font-size:1.2rem;color:var(--ink-soft);padding:.2rem .4rem;border-radius:6px}
.row-menu .dots:hover{background:rgba(12,31,36,.08)}
.menu-pop{position:absolute;right:0;top:100%;background:#fff;border:1px solid var(--line);border-radius:10px;
  box-shadow:var(--shadow-md);min-width:170px;padding:.3rem;z-index:5}
.menu-pop button{display:flex;width:100%;text-align:left;border:0;background:transparent;padding:.5rem .6rem;border-radius:7px;gap:.5rem;font-weight:500}
.menu-pop button:hover{background:#f4f7f8}
.menu-pop button.danger{color:var(--danger)}

.empty{padding:3rem 1rem;text-align:center;color:var(--ink-soft)}
.empty .big{font-size:2.4rem;margin-bottom:.4rem}

.pop-manual{position:fixed;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-md);
  padding:.9rem;width:240px;z-index:40}
.pop-manual h4{font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-bottom:.5rem}
.pop-manual .quick{display:flex;gap:.35rem;margin-bottom:.5rem;flex-wrap:wrap}
.pop-manual .quick button{flex:1;min-width:44px;border:1px solid var(--line);background:#fff;border-radius:8px;padding:.35rem 0;font-weight:700;font-family:var(--font-head)}
.pop-manual .quick button:hover{background:var(--brand-050);border-color:var(--brand)}
.pop-manual input[type=number]{width:100%;border:1px solid var(--line);border-radius:8px;padding:.4rem .5rem;margin-bottom:.4rem}
.pop-manual input[type=text]{width:100%;border:1px solid var(--line);border-radius:8px;padding:.4rem .5rem;margin-bottom:.5rem}

.logbox{margin-top:1.4rem;background:var(--card);border:1px solid var(--line);border-radius:var(--radius)}
.logbox summary{padding:.8rem 1rem;font-family:var(--font-head);text-transform:uppercase;letter-spacing:.05em;font-size:.85rem;cursor:pointer}
.logbox .items{max-height:280px;overflow:auto;border-top:1px solid var(--line)}
.logbox .li{display:flex;gap:.6rem;padding:.5rem 1rem;border-bottom:1px solid var(--line);font-size:.85rem}
.logbox .li .t{color:var(--ink-soft);font-variant-numeric:tabular-nums;flex:none;width:56px}
.logbox .li .d{flex:1}
.logbox .li .p{font-family:var(--font-head);font-weight:700}
.logbox .li .p.plus{color:var(--ok)}
.logbox .li .p.minus{color:var(--danger)}

.modal--wide{width:min(680px,100%)}
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.mini-field{display:flex;flex-direction:column;gap:.3rem}
.mini-field label{font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);font-weight:600}
.mini-field input,.mini-field select{border:1px solid var(--line);border-radius:8px;padding:.5rem .6rem}

.set-h{font-size:.95rem;text-transform:uppercase;letter-spacing:.05em;color:var(--ink);margin:1.4rem 0 .6rem;
  border-bottom:2px solid var(--line);padding-bottom:.3rem}
.mini-lbl{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);font-weight:600;margin:.7rem 0 .3rem}
.set-area{width:100%;border:1px solid var(--line);border-radius:9px;padding:.6rem;font-family:var(--font-body);resize:vertical}

.diff-table{border-collapse:collapse;width:100%}
.diff-table th{font-size:.7rem;text-transform:uppercase;letter-spacing:.03em;color:var(--ink-soft);font-weight:700;padding:.4rem .4rem;text-align:center}
.diff-table th:first-child{text-align:left}
.diff-table td{padding:.3rem .35rem}
.diff-table input[type=text]{width:100%;border:1px solid var(--line);border-radius:7px;padding:.45rem .5rem;font-weight:600}
.diff-table input[type=number]{width:64px;border:1px solid var(--line);border-radius:7px;padding:.45rem .4rem;text-align:center}

.out-area{width:100%;border:1px solid var(--line);border-radius:9px;padding:.6rem;
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;resize:vertical;background:#fbfdfd}

/* ============ leaderboard.css ============ */
/* Denní režim (výchozí): projektor přes den prosvětlí tmavé plochy do šeda, takže
   čitelnost drží jen tmavý text na bílé. Noční režim = čistě černé pozadí, bílý text. */
:root{
  --lb-bg:#ffffff;
  --lb-ink:#000a0d; --lb-ink-dim:#14323a;
  --lb-card:#e6f3f6;
  --lb-line:#5f8d97;
  --lb-accent:#005466;
  --lb-up:#0a6b2c; --lb-live:#8a4b00;
  --lb-pod1-line:#b37a00;
}
body.lb-mode.lb-night{
  --lb-bg:#000000;
  --lb-ink:#ffffff; --lb-ink-dim:#d3ebf0;
  --lb-card:#0f2329;
  --lb-line:#5aa7b5;
  --lb-accent:#4fe6fb;
  --lb-up:#ffd166; --lb-live:#ffd166;
  --lb-pod1-line:#ffc24b;
}
body.lb-mode{
  height:100%;
  background:var(--lb-bg);
  color:var(--lb-ink);
  overflow:hidden;
}
.lb-theme{position:fixed;right:1.2vw;bottom:1.2vh;z-index:30;border:2px solid var(--lb-line);
  background:var(--lb-card);color:var(--lb-ink);font-family:var(--font-head);font-weight:600;
  text-transform:uppercase;letter-spacing:.08em;font-size:.85rem;padding:.35rem .8rem;border-radius:999px;
  opacity:.35;transition:opacity .2s}
.lb-theme:hover,.lb-theme:focus-visible{opacity:1}

.board{position:fixed;inset:0;display:flex;flex-direction:column;padding:2.4vh 3vw}

.lb-head{display:flex;align-items:center;gap:1.2rem;flex:none}
.lb-head .mark{width:4.4vh;height:4.4vh;min-width:38px}
.lb-head h1{
  font-size:clamp(1.6rem,4.2vh,3rem);text-transform:uppercase;letter-spacing:.04em;line-height:1;
}
.lb-head h1{font-weight:700}
.lb-head h1 b{color:var(--lb-accent)}
.lb-head .edition{font-family:var(--font-head);font-weight:600;color:var(--lb-ink-dim);letter-spacing:.3em;
  text-transform:uppercase;font-size:clamp(.7rem,1.5vh,1rem);margin-top:.3rem}
.lb-head .spacer{flex:1}
.lb-clock{text-align:right;font-family:var(--font-head);line-height:1}
.lb-clock .time{font-size:clamp(1.4rem,3.4vh,2.4rem);font-weight:700;font-variant-numeric:tabular-nums}
.lb-clock .cd{color:var(--lb-accent);font-weight:600;font-size:clamp(.8rem,1.8vh,1.2rem);letter-spacing:.08em;margin-top:.2rem;font-variant-numeric:tabular-nums}
.lb-clock .cd.live{color:var(--lb-live)}
.lb-clock .cd.ready{color:var(--lb-ink-dim)}

.podium{
  flex:none;display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:1.4vw;align-items:end;
  margin:1.6vh 0 1.4vh;
}
.pod{
  position:relative;background:var(--lb-card);border:2px solid var(--lb-line);border-radius:18px;
  padding:1.6vh 1vw 1.4vh;text-align:center;
  transition:transform .5s cubic-bezier(.22,1,.36,1), box-shadow .5s;
}
.pod .badge{
  position:absolute;top:-2.4vh;left:50%;transform:translateX(-50%);
  width:4.6vh;height:4.6vh;min-width:40px;min-height:40px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;font-family:var(--font-head);font-weight:700;
  font-size:2.2vh;color:#000;border:2px solid rgba(0,0,0,.45);box-shadow:0 4px 12px rgba(0,0,0,.25);
}
.pod--1{transform:translateY(-2.4vh)}
.pod--1 .badge{background:var(--gold)}
.pod--1{border:3px solid var(--lb-pod1-line);box-shadow:0 0 40px rgba(255,194,75,.25)}
.pod--2 .badge{background:var(--silver)}

.pod--3 .badge{background:var(--bronze)}

.pod .rank-word{font-family:var(--font-head);font-weight:600;text-transform:uppercase;letter-spacing:.12em;
  color:var(--lb-ink-dim);font-size:clamp(.65rem,1.4vh,.9rem);margin-top:1.2vh}
.pod .name{font-family:var(--font-head);font-weight:700;text-transform:uppercase;
  font-size:clamp(1.1rem,3.1vh,2.3rem);line-height:1.05;margin:.4vh 0;word-break:break-word}
.pod--1 .name{font-size:clamp(1.3rem,3.8vh,2.9rem)}
.pod .pts{font-family:var(--font-head);font-weight:700;color:var(--lb-accent);
  font-size:clamp(1.4rem,3.6vh,2.6rem);font-variant-numeric:tabular-nums}
.pod .pts small{color:var(--lb-ink-dim);font-size:.5em;font-weight:700}
.pod .bar{height:1vh;border-radius:999px;margin-top:1vh;background:linear-gradient(90deg,var(--brand),var(--brand-700))}
.pod--2 .bar,.pod--3 .bar{opacity:.7}
.pod.bumped{animation:podBump .6s ease}
@keyframes podBump{0%{transform:translateY(var(--y,0)) scale(1)}30%{transform:translateY(var(--y,0)) scale(1.04)}100%{transform:translateY(var(--y,0)) scale(1)}}

.list{flex:1;position:relative;overflow:hidden;--cols:1;--rows:10;--rh:1}
.list-inner{position:absolute;inset:0;display:grid;
  grid-template-columns:repeat(var(--cols),1fr);
  grid-template-rows:repeat(var(--rows),min-content);
  grid-auto-flow:column;
  gap:calc(.9vh * var(--rh)) 1.6vw;align-content:start}

.rowx{
  display:grid;grid-template-columns:3.4vw 1fr auto;align-items:center;gap:1vw;
  background:var(--lb-card);border:2px solid var(--lb-line);border-radius:12px;
  padding:calc(1vh * var(--rh)) 1.3vw;
  will-change:transform;
}
.rowx .rk{font-family:var(--font-head);font-weight:700;font-size:calc(clamp(1rem,2.5vh,1.8rem) * var(--rh));
  color:var(--lb-ink);text-align:center;font-variant-numeric:tabular-nums}
.rowx .nm{font-family:var(--font-head);font-weight:700;text-transform:uppercase;
  font-size:calc(clamp(1rem,2.6vh,1.9rem) * var(--rh));letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rowx .ps{font-family:var(--font-head);font-weight:700;font-variant-numeric:tabular-nums;
  font-size:calc(clamp(1.1rem,2.8vh,2rem) * var(--rh));color:var(--lb-accent)}
.rowx .mv{display:inline-block;width:1.4vw;min-width:12px;text-align:center;font-size:.75em}
.mv.up{color:var(--lb-up)} .mv.down{color:var(--lb-ink-dim)} .mv.flat{opacity:0}
.rowx.pts-bump{animation:ptsBump .8s ease}
@keyframes ptsBump{0%{background:rgba(0,187,214,.45);border-color:var(--lb-accent)}100%{background:var(--lb-card);border-color:var(--lb-line)}}

.lb-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--lb-ink-dim);font-weight:600;font-size:clamp(1rem,2.6vh,1.8rem);gap:1rem}
.lb-empty .big{font-size:12vh}

.lb-foot.lb-offline::after{content:attr(data-msg);display:block;color:#B02A15;margin-top:.3rem;letter-spacing:.06em}
body.lb-night .lb-foot.lb-offline::after{color:#ff8a75}
.lb-foot{flex:none;text-align:center;color:var(--lb-ink-dim);font-weight:600;font-size:clamp(.7rem,1.5vh,.95rem);
  padding-top:1.4vh;font-family:var(--font-head);letter-spacing:.14em;text-transform:uppercase}

@media (max-width: 760px){
  body.lb-mode{overflow:auto;height:auto}
  .board{position:static;min-height:100vh;padding:16px}
  .lb-head{gap:.7rem}
  .lb-head h1{font-size:1.35rem}
  .lb-head .edition{font-size:.7rem;letter-spacing:.18em}
  .lb-clock .time{font-size:1.2rem}
  .lb-clock .cd{font-size:.75rem}
  .podium{gap:8px;margin:2.2rem 0 1rem}
  .pod{padding:1.6rem 6px 10px;border-radius:14px}
  .pod .badge{top:-18px;width:36px;height:36px;min-width:36px;min-height:36px;font-size:1.05rem;border-radius:10px}
  .pod .rank-word{font-size:.6rem;margin-top:4px}
  .pod .name,.pod--1 .name{font-size:1rem}
  .pod .pts{font-size:1.4rem}
  .pod .bar{height:5px}
  .list{flex:none;overflow:visible}
  .list-inner{position:static;gap:8px}
  .rowx{grid-template-columns:2.2rem 1fr auto;gap:.6rem;padding:.6rem .8rem;border-radius:10px}
  .rowx .rk{font-size:1.05rem}
  .rowx .nm{font-size:1.05rem}
  .rowx .ps{font-size:1.2rem}
  .rowx .mv{width:1rem}
  .lb-foot{padding-top:1rem;font-size:.7rem}
  .lb-theme{font-size:.75rem}
}
.confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:20}
.confetti i{position:absolute;top:-5vh;width:.8vw;height:1.4vh;opacity:.9;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.2}}

@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
  .confetti{display:none}
}

.brandmark,.mark{object-fit:contain;aspect-ratio:1}
.launch .brandmark{width:120px;height:auto}
.top .mark{width:44px;height:44px}
.lb-head .mark{width:5.4vh;height:5.4vh;min-width:44px;min-height:44px}
.launch .links{margin-top:1.4rem;display:flex;gap:1.2rem;justify-content:center;flex-wrap:wrap}
.launch .links a{color:#d2ecf1;text-decoration:none;font-family:var(--font-head);text-transform:uppercase;letter-spacing:.12em;font-size:.85rem}
.launch .links a:hover{color:var(--brand)}
.top .home{font-size:.82rem;color:var(--ink-soft);text-decoration:none;font-weight:600}
.top .home:hover{color:var(--brand-700)}
</style>
  </head>
