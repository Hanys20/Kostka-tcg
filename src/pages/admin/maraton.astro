<script is:inline>
/* ============================================================
 * store.js — sdílený stav (localStorage tohoto prohlížeče)
 * ========================================================== */
(function (global) {
  'use strict';

  var KEY = 'kostka-maraton-v1';
  var SNAP_KEY = 'kostka-maraton-snapshots-v1';
  var CH = 'kostka-maraton-sync-v1';

  function defaultTasks() {
    var a = [];
    for (var i = 1; i <= 12; i++) a.push({ id: 't' + i, label: 'Úkol ' + i });
    return a;
  }
  function defaultDifficulties() {
    return [
      { id: 'dn', name: 'Deskonoob',     play: 2,  p1: 5,  p2: 3,  p3: 2 },
      { id: 'mp', name: 'Medium play',   play: 5,  p1: 10, p2: 5,  p3: 3 },
      { id: 'kp', name: 'Kostka profík', play: 12, p1: 15, p2: 10, p3: 5 }
    ];
  }

  var DEFAULT_STATE = {
    version: 2,
    rev: 0,
    updatedAt: 0,
    settings: {
      eventName: 'KOSTKA',
      subtitle: 'MARATON HER',
      edition: String(new Date().getFullYear()),
      pointsPerTask: 10,
      tasks: defaultTasks(),
      difficulties: defaultDifficulties(),
      raceHours: 24,
      raceStartAt: null,
      sortMode: 'total'
    },
    participants: [],
    log: []
  };

  function clone(o) { return JSON.parse(JSON.stringify(o)); }
  function now() { return Date.now(); }
  function uid() {
    return 'p' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  }
  function num(v, d) { var n = Number(v); return isFinite(n) ? n : (d || 0); }

  function tierIds(s) { return (s.difficulties || []).map(function (d) { return d.id; }); }

  function migrate(s) {
    var d = clone(DEFAULT_STATE);
    if (!s || typeof s !== 'object') return d;
    d.rev = s.rev || 0;
    d.updatedAt = s.updatedAt || 0;

    var ss = s.settings || {};
    d.settings.eventName = ss.eventName || d.settings.eventName;
    d.settings.subtitle = ss.subtitle != null ? ss.subtitle : d.settings.subtitle;
    d.settings.edition = ss.edition != null ? ss.edition : d.settings.edition;
    d.settings.pointsPerTask = Math.max(0, num(ss.pointsPerTask, 10));
    d.settings.raceHours = Math.max(1, num(ss.raceHours, 24));
    d.settings.raceStartAt = ss.raceStartAt || null;
    if (!d.settings.raceStartAt && ss.countdownTarget) {
      var end = new Date(ss.countdownTarget).getTime();
      if (isFinite(end)) d.settings.raceStartAt = end - d.settings.raceHours * 3600e3;
    }
    d.settings.sortMode = ss.sortMode || 'total';

    if (Array.isArray(ss.tasks) && ss.tasks.length) {
      d.settings.tasks = ss.tasks.map(function (t, i) {
        if (typeof t === 'string') return { id: 't' + (i + 1), label: t };
        return { id: t.id || ('t' + (i + 1)), label: t.label || ('Úkol ' + (i + 1)) };
      });
    }
    if (Array.isArray(ss.difficulties) && ss.difficulties.length) {
