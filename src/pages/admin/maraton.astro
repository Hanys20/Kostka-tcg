<script is:inline>
/* nastav režim co nejdřív, ať nebliká špatná obrazovka */
(function(){
  try{
    var h=(location.hash||'').replace(/^#\/?/,'').toLowerCase();
    var m = h.indexOf('tabule')===0 ? 'admin-mode'
          : (h.indexOf('leaderboard')===0 || h.indexOf('board')===0) ? 'lb-mode'
          : 'launch-mode';
    if(document.body) document.body.className = m;
    else document.addEventListener('DOMContentLoaded',function(){document.body.className=m;});
  }catch(e){}
})();
</script>

