        }
      }
      entry.undone = true;
      this._pushLog({ type: 'undo', label: entry.label, ref: entry.id });
      this._persist();
      return true;
    },

    startRace: function () {
      this.state.settings.raceStartAt = now();
      this._pushLog({ type: 'race-start', hours: this.state.settings.raceHours });
      this._persist();
    },
    restartRace: function () {
      this.state.settings.raceStartAt = now();
      this._pushLog({ type: 'race-restart', hours: this.state.settings.raceHours });
      this._persist();
    },
    cancelRace: function () {
      this.state.settings.raceStartAt = null;
      this._pushLog({ type: 'race-cancel' });
      this._persist();
    },

    updateSettings: function (patch) {
      var s = this.state.settings;
      ['eventName', 'subtitle', 'edition', 'pointsPerTask', 'sortMode'].forEach(function (k) {
        if (k in patch) s[k] = patch[k];
      });
      if ('raceHours' in patch) s.raceHours = Math.max(1, num(patch.raceHours, 24));
      if (patch.difficulties) {
        s.difficulties = patch.difficulties.map(function (d, i) {
          var old = s.difficulties[i] || {};
          return {
            id: old.id || d.id || ('d' + (i + 1)),
            name: d.name || old.name,
            play: Math.max(0, num(d.play, 0)),
            p1: Math.max(0, num(d.p1, 0)),
            p2: Math.max(0, num(d.p2, 0)),
            p3: Math.max(0, num(d.p3, 0))
          };
        });
      }
      if (patch.tasks) {
        var newTasks = patch.tasks.map(function (label, i) {
          return { id: (s.tasks[i] && s.tasks[i].id) || ('t' + (i + 1) + '_' + Math.random().toString(36).slice(2, 5)), label: label };
        });
        var oldLen = s.tasks.length, newLen = newTasks.length;
        s.tasks = newTasks;
        if (newLen < oldLen) {
          this.state.participants.forEach(function (p) {
            p.tasksDone = p.tasksDone.filter(function (idx) { return idx < newLen; });
          });
        }
      }
      this._persist();
    },

    resetScores: function () {
      this._snapshot(true);
      var s = this.state.settings;
      this.state.participants.forEach(function (p) {
        p.tasksDone = [];
        p.games = {}; p.places = {};
        s.difficulties.forEach(function (d) { p.games[d.id] = 0; p.places[d.id] = [0, 0, 0]; });
        p.manual = 0;
      });
      this._pushLog({ type: 'reset-scores' });
      this._persist();
    },

    replaceState: function (obj) { this._snapshot(true); this.state = migrate(obj); this._persist(); },

    exportJSON: function () { return JSON.stringify(this.state, null, 2); },

    exportCSV: function () {
      var self = this, diffs = this.state.settings.difficulties;
      var head = ['poradi', 'jmeno', 'prezdivka', 'zobrazeno', 'startovne', 'ukoly_splneno'];
      diffs.forEach(function (d) {
        head.push(d.id + '_ucast', d.id + '_1', d.id + '_2', d.id + '_3');
      });
      head.push('rucni', 'celkem');
      var rows = [head];
      this.ranking().forEach(function (r) {
        var p = r.p;
        var row = [
          r.rank, (p.firstName + ' ' + p.lastName).trim(), p.nickname, r.name,
          p.paid ? 'ano' : 'ne', p.tasksDone.length
        ];
        diffs.forEach(function (d) {
          var pl = p.places[d.id] || [0, 0, 0];
          row.push(p.games[d.id] || 0, pl[0], pl[1], pl[2]);
        });
        row.push(p.manual, r.points);
        rows.push(row);
      });
      return rows.map(function (r) {
        return r.map(function (c) {
          c = String(c);
          return /[";\n]/.test(c) ? '"' + c.replace(/"/g, '""') + '"' : c;
        }).join(';');
      }).join('\n');
    }
  };

  Store.parseBulk = function (text) {
    return text.split(/\r?\n/).map(function (line) {
      line = line.trim();
      if (!line) return null;
      var nick = '', parts = line.split('|');
      var namePart = parts[0].trim();
      if (parts.length > 1) nick = parts.slice(1).join('|').trim();
      var tokens = namePart.split(/\s+/);
      if (tokens.length === 1) return { firstName: tokens[0], lastName: '', nickname: nick };
      return { firstName: tokens.slice(0, -1).join(' '), lastName: tokens[tokens.length - 1], nickname: nick };
    }).filter(Boolean);
  };

  global.KMH = Store;
})(window);
</script>

<script is:inline>
/* ============================================================
 * initAdmin() — obrazovka "Tabule" (jediné zapisující místo)
 * ========================================================== */
function initAdmin() {
  'use strict';
  if (initAdmin._done) return; initAdmin._done = true;
  var S = window.KMH.init({ writer: true });

  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var rowsEl = $('#rows'), emptyEl = $('#empty');
  var editing = null;
  var search = '';
  var flashIds = {};

  function fmtTime(ts) {
    var d = new Date(ts);
    return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
  }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  }); }

  function stepper(id, kind, val, mini) {
    return '<span class="stepper' + (mini ? ' mini' : '') + '" data-id="' + id + '" data-kind="' + kind + '">' +
      '<button data-dir="-1" aria-label="odebrat"' + (val <= 0 ? ' disabled' : '') + '>−</button>' +
      '<span class="v">' + val + '</span>' +
      '<button data-dir="1" aria-label="přidat">+</button></span>';
  }

  function tasksCell(p) {
    var tasks = S.state.settings.tasks;
    var doneSet = {};
    p.tasksDone.forEach(function (i) { doneSet[i] = true; });
    var cells = tasks.map(function (t, i) {
      return '<button class="tk' + (doneSet[i] ? ' done' : '') + '" data-act="task" data-idx="' + i + '" ' +
        'title="' + esc(t.label) + (doneSet[i] ? ' — splněno' : '') + '">' + (i + 1) + '</button>';
    }).join('');
    return '<div class="task-grid">' + cells + '</div>' +
      '<span class="task-count"><b>' + p.tasksDone.length + '</b>/' + tasks.length +
      ' · ' + S.taskPoints(p) + ' b</span>';
  }

  function tiersCell(p) {
    var diffs = S.state.settings.difficulties;
    var head = '<thead><tr><th></th><th>hra</th><th>🥇</th><th>🥈</th><th>🥉</th></tr></thead>';
    var body = diffs.map(function (d) {
      var pl = p.places[d.id] || [0, 0, 0];
      return '<tr><th title="' + esc(d.name) + '">' + esc(shortName(d)) + '</th>' +
        '<td class="tier-play">' + stepper(p.id, 'game:' + d.id, p.games[d.id] || 0, true) + '</td>' +
        '<td>' + stepper(p.id, 'place:' + d.id + ':0', pl[0], true) + '</td>' +
        '<td>' + stepper(p.id, 'place:' + d.id + ':1', pl[1], true) + '</td>' +
        '<td>' + stepper(p.id, 'place:' + d.id + ':2', pl[2], true) + '</td></tr>';
    }).join('');
    return '<table class="tiers">' + head + '<tbody>' + body + '</tbody></table>';
  }

  function shortName(d) {
    if (d.id && d.id.length <= 3) return d.id.toUpperCase();
    var w = (d.name || '').trim().split(/\s+/);
    if (w.length >= 2) return (w[0][0] + w[1][0]).toUpperCase();
    return (d.name || '').slice(0, 3).toUpperCase();
  }

  function render(state, origin) {
    $('#evtName').textContent = state.settings.eventName || 'KOSTKA';
    $('#evtSub').textContent = (state.settings.subtitle || '') + ' · TABULE';
    document.title = 'Tabule · ' + (state.settings.eventName || 'Kostka') + ' maraton';
    $('#hTask').textContent = '(' + state.settings.pointsPerTask + ' b/kus)';
    $('#hTiers').textContent = state.settings.difficulties.map(function (d) {
      return shortName(d) + ' ' + d.play + '·' + d.p1 + '/' + d.p2 + '/' + d.p3;
    }).join('   ·   ');
    $('#sortMode').value = state.settings.sortMode || 'total';

    var ranking = S.ranking();
    var rankById = {};
    ranking.forEach(function (r) { rankById[r.p.id] = r; });

    var view = ranking.slice();
    var mode = state.settings.sortMode || 'total';
    if (mode === 'name') view.sort(function (a, b) { return a.name.localeCompare(b.name, 'cs'); });
    else if (mode === 'added') view.sort(function (a, b) { return a.p.createdAt - b.p.createdAt; });

    if (search) {
      var q = search.toLowerCase();
      view = view.filter(function (r) {
        var p = r.p;
        return (p.firstName + ' ' + p.lastName + ' ' + p.nickname + ' ' + r.name).toLowerCase().indexOf(q) >= 0;
      });
    }

    emptyEl.hidden = state.participants.length > 0;
    $('.grid').style.display = state.participants.length ? '' : 'none';

    rowsEl.innerHTML = view.map(function (r) {
      var p = r.p, pts = r.points, rank = rankById[p.id].rank;
      var medal = (pts > 0 && rank === 1) ? '🥇' : (pts > 0 && rank === 2) ? '🥈' : (pts > 0 && rank === 3) ? '🥉' : rank;
      var sub = '';
      if (p.displayMode === 'nick' && p.nickname.trim()) sub = (p.firstName + ' ' + p.lastName).trim();
      else if (p.nickname.trim()) sub = '„' + p.nickname.trim() + '“';

      return '<tr data-id="' + p.id + '"' + (flashIds[p.id] ? ' class="flash"' : '') + '>' +
        '<td class="col-rank"><span class="' + (pts > 0 && rank <= 3 ? 'rank-medal' : '') + '">' + medal + '</span></td>' +
        '<td class="col-name"><div class="name-cell">' +
          '<div><div class="name-main">' + esc(r.name) + '</div>' +
          (sub ? '<div class="name-sub">' + esc(sub) + '</div>' : '') + '</div>' +
          '<button class="name-toggle" data-act="toggleMode" title="Přepnout zobrazení jméno / přezdívka">' +
            (p.displayMode === 'nick' && p.nickname.trim() ? 'přezdívka' : 'jméno') + '</button>' +
        '</div></td>' +
        '<td class="col-paid paid-box"><input type="checkbox" data-act="paid"' + (p.paid ? ' checked' : '') + ' title="Startovné"></td>' +
        '<td class="tasks-cell">' + tasksCell(p) + '</td>' +
        '<td class="tiers-cell">' + tiersCell(p) + '</td>' +
        '<td class="col-manual"><button class="manual-btn' + (p.manual ? ' has' : '') + '" data-act="manual">' +
          (p.manual ? (p.manual > 0 ? '+' : '') + p.manual + ' b' : '+ body') + '</button></td>' +
        '<td class="col-total"><span class="total-badge">' + pts + '</span></td>' +
        '<td class="col-menu"><div class="row-menu"><button class="dots" data-act="menu" aria-label="Možnosti">⋯</button></div></td>' +
      '</tr>';
    }).join('');

    flashIds = {};
    renderSummary(state, ranking);
    renderLog(state);
  }

  function renderSummary(state, ranking) {
    var paid = state.participants.filter(function (p) { return p.paid; }).length;
    var games = state.participants.reduce(function (s, p) { return s + S.tierGamesTotal(p); }, 0);
    var tasks = state.participants.reduce(function (s, p) { return s + p.tasksDone.length; }, 0);
    var leader = ranking[0];
    var cells = [
      ['Účastníci', state.participants.length],
      ['Zaplaceno startovné', paid + ' / ' + state.participants.length],
      ['Odehrané hry / splněné úkoly', games + ' / ' + tasks],
      ['Vede', leader && leader.points > 0 ? S.displayName(leader.p) + ' · ' + leader.points + ' b' : '—']
    ];
    $('#summary').innerHTML = cells.map(function (c) {
      return '<div class="stat"><div class="n">' + esc(String(c[1])) + '</div><div class="l">' + c[0] + '</div></div>';
    }).join('');
  }

  function renderLog(state) {
    var box = $('#logItems');
    if (!state.log.length) { box.innerHTML = '<div class="li"><div class="d" style="color:var(--ink-soft)">Zatím žádné změny.</div></div>'; return; }
    box.innerHTML = state.log.slice(0, 120).map(function (e) {
      var d = '';
      if (e.type === 'bump') {
        var sign = e.deltaPts > 0 ? 'plus' : (e.deltaPts < 0 ? 'minus' : '');
        d = esc(e.label) + ' — ' + kindLabel(e.kind) +
          ' <span class="p ' + sign + '">' + (e.deltaPts > 0 ? '+' : '') + e.deltaPts + ' b</span>' +
          (e.note ? ' <span style="color:var(--ink-soft)">(' + esc(e.note) + ')</span>' : '') +
          (e.undone ? ' <s style="color:var(--ink-soft)">vzato zpět</s>' : '');
      } else if (e.type === 'task') {
        var s2 = e.done ? 'plus' : 'minus';
        d = esc(e.label) + ' — ' + esc(e.taskLabel) + ' ' + (e.done ? 'splněn' : 'odškrtnut') +
          ' <span class="p ' + s2 + '">' + (e.deltaPts > 0 ? '+' : '') + e.deltaPts + ' b</span>' +
          (e.undone ? ' <s style="color:var(--ink-soft)">vzato zpět</s>' : '');
      }
      else if (e.type === 'add') d = 'Přidán ' + esc(e.label);
      else if (e.type === 'remove') d = 'Odebrán ' + esc(e.label);
      else if (e.type === 'import') d = 'Import ' + e.count + ' účastníků';
      else if (e.type === 'undo') d = '↩︎ Vráceno zpět: ' + esc(e.label || '');
      else if (e.type === 'reset-scores') d = 'Body vynulovány';
      else d = e.type;
      return '<div class="li"><div class="t">' + fmtTime(e.ts) + '</div><div class="d">' + d + '</div></div>';
    }).join('');
  }

  function kindLabel(kind) {
    var parts = kind.split(':');
    var d = S.diff(parts[1]);
    var dn = d ? d.name : parts[1];
    if (parts[0] === 'game') return 'zahraná hra (' + dn + ')';
    if (parts[0] === 'place') return ['1.', '2.', '3.'][+parts[2]] + ' místo (' + dn + ', vč. hry)';
    if (parts[0] === 'manual') return 'ruční';
    return kind;
  }

  rowsEl.addEventListener('click', function (e) {
    var tk = e.target.closest('.tk[data-act="task"]');
    if (tk) {
      var tr0 = tk.closest('tr');
      flashIds[tr0.getAttribute('data-id')] = true;
      S.toggleTask(tr0.getAttribute('data-id'), parseInt(tk.getAttribute('data-idx'), 10));
      return;
    }
    var stepEl = e.target.closest('.stepper');
    if (stepEl && e.target.matches('button[data-dir]')) {
      var dir = parseInt(e.target.getAttribute('data-dir'), 10);
      flashIds[stepEl.getAttribute('data-id')] = true;
      S.bump(stepEl.getAttribute('data-id'), stepEl.getAttribute('data-kind'), dir);
      return;
    }
    var act = e.target.getAttribute('data-act');
    if (!act) return;
    var tr = e.target.closest('tr'); var id = tr && tr.getAttribute('data-id');
    if (act === 'toggleMode') {
      var p = S.state.participants.find(function (x) { return x.id === id; });
      S.updateParticipant(id, { displayMode: p.displayMode === 'nick' ? 'name' : 'nick' });
    } else if (act === 'manual') openManualPop(e.target, id);
    else if (act === 'menu') openRowMenu(e.target, id);
  });

  rowsEl.addEventListener('change', function (e) {
    if (e.target.getAttribute('data-act') === 'paid') {
      var tr = e.target.closest('tr');
      S.updateParticipant(tr.getAttribute('data-id'), { paid: e.target.checked });
    }
  });

  function closePops() { $$('.menu-pop, .pop-manual').forEach(function (x) { x.remove(); }); }
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.menu-pop') && !e.target.closest('.pop-manual') &&
        !e.target.closest('#btnRace') &&
        !e.target.matches('[data-act="menu"]') && !e.target.matches('[data-act="manual"]')) closePops();
  });

  function openRowMenu(btn, id) {
    closePops();
    var pop = document.createElement('div');
    pop.className = 'menu-pop';
    pop.innerHTML =
      '<button data-m="edit">✎ Upravit jméno</button>' +
      '<button data-m="up">▲ Přesunout nahoru (dřív přidán)</button>' +
      '<button class="danger" data-m="del">🗑 Smazat účastníka</button>';
    btn.parentNode.appendChild(pop);
    pop.addEventListener('click', function (e) {
      var m = e.target.getAttribute('data-m'); if (!m) return;
      if (m === 'edit') openEdit(id);
      if (m === 'del') {
        var p = S.state.participants.find(function (x) { return x.id === id; });
        if (confirm('Smazat účastníka „' + S.displayName(p) + '“? Body budou ztraceny.')) S.removeParticipant(id);
      }
      if (m === 'up') {
        var pp = S.state.participants.find(function (x) { return x.id === id; });
        pp.createdAt = Math.min.apply(null, S.state.participants.map(function (x) { return x.createdAt; })) - 1;
        S.updateParticipant(id, {});
      }
      closePops();
    });
  }

  function openManualPop(btn, id) {
    closePops();
    var rect = btn.getBoundingClientRect();
    var pop = document.createElement('div');
    pop.className = 'pop-manual';
    pop.innerHTML =
      '<h4>Ruční úprava bodů</h4>' +
      '<div class="quick">' +
        '<button data-q="1">+1</button><button data-q="5">+5</button>' +
        '<button data-q="10">+10</button><button data-q="-5">−5</button>' +
      '</div>' +
      '<input type="number" placeholder="vlastní ± body" id="mNum">' +
      '<input type="text" placeholder="poznámka (volitelné)" id="mNote">' +
      '<button class="btn btn--primary" style="width:100%" id="mApply">Přičíst</button>';
    document.body.appendChild(pop);
    var top = Math.min(rect.bottom + 6, window.innerHeight - pop.offsetHeight - 8);
    var left = Math.min(rect.left, window.innerWidth - pop.offsetWidth - 8);
    pop.style.top = top + 'px'; pop.style.left = Math.max(8, left) + 'px';
    function apply(val) {
      val = Math.round(Number(val) || 0);
      if (!val) return;
      S.bump(id, 'manual', val, { note: $('#mNote', pop).value.trim() });
      flashIds[id] = true; closePops();
    }
    $$('.quick button', pop).forEach(function (b) { b.addEventListener('click', function () { apply(b.getAttribute('data-q')); }); });
    $('#mApply', pop).addEventListener('click', function () { apply($('#mNum', pop).value); });
    $('#mNum', pop).addEventListener('keydown', function (e) { if (e.key === 'Enter') apply(e.target.value); });
    $('#mNum', pop).focus();
  }

  function openModal(sel) { $(sel).classList.add('open'); }
  function closeModal(sel) { $(sel).classList.remove('open'); }
  $$('[data-close]').forEach(function (b) {
    b.addEventListener('click', function () { b.closest('.modal-backdrop').classList.remove('open'); });
  });
  $$('.modal-backdrop').forEach(function (bd) {
    bd.addEventListener('click', function (e) { if (e.target === bd) bd.classList.remove('open'); });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') $$('.modal-backdrop.open').forEach(function (m) { m.classList.remove('open'); });
  });

  function openEdit(id) {
    editing = id || null;
    var p = id ? S.state.participants.find(function (x) { return x.id === id; }) : null;
    $('#mEditTitle').textContent = id ? 'Upravit účastníka' : 'Přidat účastníka';
    $('#fFirst').value = p ? p.firstName : '';
    $('#fLast').value = p ? p.lastName : '';
    $('#fNick').value = p ? p.nickname : '';
    $('#fMode').value = p ? p.displayMode : 'nick';
    $('#fPaid').checked = p ? p.paid : false;
    openModal('#mEdit');
    setTimeout(function () { $('#fFirst').focus(); }, 60);
  }
  $('#mEditSave').addEventListener('click', function () {
    var data = {
      firstName: $('#fFirst').value, lastName: $('#fLast').value,
      nickname: $('#fNick').value, displayMode: $('#fMode').value, paid: $('#fPaid').checked
    };
    if (!data.firstName && !data.lastName && !data.nickname) { alert('Vyplň aspoň jméno nebo přezdívku.'); return; }
    if (editing) S.updateParticipant(editing, data);
    else S.addParticipant(data);
    closeModal('#mEdit');
  });
  $('#mEdit').addEventListener('keydown', function (e) { if (e.key === 'Enter' && e.target.tagName === 'INPUT') $('#mEditSave').click(); });

  $('#btnAdd').addEventListener('click', function () { openEdit(null); });
  $('#btnImport').addEventListener('click', function () { $('#bulkText').value = ''; openModal('#mBulk'); });
  $('#bulkAdd').addEventListener('click', function () {
    var rows = window.KMH.parseBulk($('#bulkText').value);
    if (!rows.length) { alert('Nic k přidání.'); return; }
    var n = S.addMany(rows);
    closeModal('#mBulk');
    toast(n + ' účastníků přidáno');
  });

  $('#btnUndo').addEventListener('click', function () { if (!S.undoLast()) toast('Není co vrátit'); });
  $('#search').addEventListener('input', function (e) { search = e.target.value; render(S.state); });
  $('#sortMode').addEventListener('change', function (e) { S.updateSettings({ sortMode: e.target.value }); });
  $('#btnBoard').addEventListener('click', function () {
    var url = location.pathname + '#/leaderboard';
    var w = null;
    try { w = window.open(url, 'kmh_leaderboard'); } catch (e) {}
    if (w) return;
    // Vyskakovací okna blokovaná (typicky uvnitř Artifactu) — otevři leaderboard v tomto okně
    if (confirm('Prohlížeč zablokoval nové okno. Povol pro tuhle stránku vyskakovací okna, nebo otevři Leaderboard ručně v nové záložce.\n\nOtevřít ho místo toho tady?')) {
      location.hash = '#/leaderboard';
    }
  });

  function hms(ms) {
    var t = Math.max(0, Math.floor(ms / 1000));
    var h = Math.floor(t / 3600), m = Math.floor(t % 3600 / 60), s = t % 60;
    var p = function (n) { return ('0' + n).slice(-2); };
    return p(h) + ':' + p(m) + ':' + p(s);
  }
  function renderRaceBtn() {
    var b = $('#btnRace'); if (!b) return;
    var r = S.raceInfo();
    b.classList.remove('btn--primary', 'btn--danger', 'race-live', 'race-done');
    if (!r.started) {
      b.textContent = '▶ Spustit maraton (' + r.hours + ' h)';
      b.classList.add('btn--primary');
      b.title = 'Spustí ' + r.hours + 'h odpočet na leaderboardu';
    } else if (!r.done) {
      b.textContent = '⏱ ' + hms(r.remainingMs) + ' do konce';
      b.classList.add('race-live');
      b.title = 'Klikni pro restart / zrušení odpočtu';
    } else {
      b.textContent = '⏱ Maraton dohrán';
      b.classList.add('race-done');
      b.title = 'Klikni pro nový start / zrušení';
    }
  }
  $('#btnRace').addEventListener('click', function (e) {
    var r = S.raceInfo();
    if (!r.started) {
      if (confirm('Spustit ' + r.hours + 'hodinový maraton? Od teď běží odpočet na leaderboardu.')) {
        S.startRace(); toast('Maraton spuštěn — odpočet běží');
      }
      return;
    }
    closePops();
    var pop = document.createElement('div');
    pop.className = 'menu-pop';
    pop.style.left = 'auto'; pop.style.right = '0';
    pop.innerHTML =
      '<button data-m="restart">↻ Restartovat odpočet (' + r.hours + ' h)</button>' +
      '<button class="danger" data-m="cancel">✕ Zrušit odpočet</button>';
    e.target.parentNode.style.position = 'relative';
    e.target.parentNode.appendChild(pop);
    pop.addEventListener('click', function (ev) {
      var m = ev.target.getAttribute('data-m'); if (!m) return;
      if (m === 'restart' && confirm('Restartovat odpočet od teď?')) { S.restartRace(); toast('Odpočet restartován'); }
      if (m === 'cancel' && confirm('Zrušit odpočet? Leaderboard přestane odpočítávat.')) { S.cancelRace(); toast('Odpočet zrušen'); }
      closePops();
    });
  });
  setInterval(renderRaceBtn, 1000);

  $('#btnSettings').addEventListener('click', function () {
    var s = S.state.settings;
    $('#sName').value = s.eventName; $('#sSub').value = s.subtitle; $('#sEdition').value = s.edition;
    $('#sTask').value = s.pointsPerTask;
    $('#sTasks').value = s.tasks.map(function (t) { return t.label; }).join('\n');
    $('#sHours').value = s.raceHours;
    $('#diffRows').innerHTML = s.difficulties.map(function (d, i) {
      return '<tr data-i="' + i + '">' +
        '<td><input type="text" class="d-name" value="' + esc(d.name) + '"></td>' +
        '<td><input type="number" min="0" class="d-play" value="' + d.play + '"></td>' +
        '<td><input type="number" min="0" class="d-p1" value="' + d.p1 + '"></td>' +
        '<td><input type="number" min="0" class="d-p2" value="' + d.p2 + '"></td>' +
        '<td><input type="number" min="0" class="d-p3" value="' + d.p3 + '"></td></tr>';
    }).join('');
    openModal('#mSettings');
  });
  $('#sSave').addEventListener('click', function () {
    var tasks = $('#sTasks').value.split(/\r?\n/).map(function (x) { return x.trim(); }).filter(Boolean);
    if (!tasks.length) { alert('Musí zůstat aspoň jeden úkol.'); return; }
    var diffs = $$('#diffRows tr').map(function (tr) {
      return {
        name: $('.d-name', tr).value.trim() || 'Obtížnost',
        play: parseInt($('.d-play', tr).value, 10) || 0,
        p1: parseInt($('.d-p1', tr).value, 10) || 0,
        p2: parseInt($('.d-p2', tr).value, 10) || 0,
        p3: parseInt($('.d-p3', tr).value, 10) || 0
      };
    });
    var shrinking = tasks.length < S.state.settings.tasks.length;
    if (shrinking && !confirm('Zkracuješ seznam úkolů. U účastníků se odškrtnou úkoly nad nový počet. Pokračovat?')) return;
    S.updateSettings({
      eventName: $('#sName').value.trim() || 'KOSTKA',
      subtitle: $('#sSub').value.trim(),
      edition: $('#sEdition').value.trim(),
      pointsPerTask: Math.max(0, parseInt($('#sTask').value, 10) || 0),
      tasks: tasks,
      difficulties: diffs,
      raceHours: Math.max(1, parseInt($('#sHours').value, 10) || 24)
    });
    closeModal('#mSettings');
    toast('Nastavení uloženo');
  });

  function saveOut(name, text) {
    try {
      var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
    } catch (e) {}
    $('#mOutTitle').textContent = name;
    $('#mOutName').textContent = name;
    $('#mOutText').value = text;
    openModal('#mOut');
    setTimeout(function () { $('#mOutText').focus(); $('#mOutText').select(); }, 60);
  }
  $('#mOutCopy').addEventListener('click', function () {
    var ta = $('#mOutText');
    ta.focus(); ta.select();
    var done = function () { toast('Zkopírováno do schránky'); };
    var fail = function () { try { document.execCommand('copy'); done(); } catch (e) { toast('Zkopíruj ručně: Ctrl/Cmd + C'); } };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(ta.value).then(done, fail);
    else fail();
  });
  function stamp() {
    var d = new Date(), p = function (n) { return ('0' + n).slice(-2); };
    return d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + '-' + p(d.getHours()) + p(d.getMinutes());
  }
  $('#btnBackup').addEventListener('click', function () {
    saveOut('kostka-zaloha-' + stamp() + '.json', S.exportJSON());
    toast('Záloha připravena ke zkopírování');
  });
  $('#btnExportCSV').addEventListener('click', function () {
    saveOut('kostka-vysledky-' + stamp() + '.csv', '﻿' + S.exportCSV());
  });
  $('#btnImportJSON').addEventListener('click', function () { $('#fileJSON').click(); });
  $('#fileJSON').addEventListener('change', function (e) {
    var f = e.target.files[0]; if (!f) return;
    var r = new FileReader();
    r.onload = function () {
      try {
        var obj = JSON.parse(r.result);
        if (!confirm('Nahradit současná data obsahem zálohy? Aktuální stav se uloží jako snapshot.')) return;
        S.replaceState(obj);
        closeModal('#mSettings');
        toast('Záloha načtena');
      } catch (x) { alert('Soubor se nepodařilo načíst: ' + x.message); }
    };
    r.readAsText(f);
    e.target.value = '';
  });
  $('#btnResetScores').addEventListener('click', function () {
    if (confirm('Vynulovat VŠECHNY body všem účastníkům? Jména zůstanou. (Uloží se snapshot.)')) {
      S.resetScores(); toast('Body vynulovány');
    }
  });
  $('#btnSnapshots').addEventListener('click', function () {
    var list = S.snapshots();
    $('#snapList').innerHTML = list.length ? list.map(function (s) {
      var d = new Date(s.ts);
      var cnt = (s.state.participants || []).length;
      return '<div class="li" style="display:flex;justify-content:space-between;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--line)">' +
        '<span>' + d.toLocaleString('cs') + ' · ' + cnt + ' účastníků</span>' +
        '<button class="btn btn--sm" data-ts="' + s.ts + '">Obnovit</button></div>';
    }).join('') : '<p style="color:var(--ink-soft)">Zatím žádné snapshoty.</p>';
    openModal('#mSnap');
  });
  $('#snapList').addEventListener('click', function (e) {
    var ts = e.target.getAttribute('data-ts'); if (!ts) return;
    if (confirm('Obnovit stav z tohoto snapshotu?')) {
      S.restoreSnapshot(parseInt(ts, 10));
      closeModal('#mSnap'); closeModal('#mSettings');
      toast('Obnoveno ze snapshotu');
    }
  });

  var toastT;
  function toast(msg) {
    var t = $('#toast');
    if (!t) { t = document.createElement('div'); t.id = 'toast';
      t.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#0c1f24;color:#fff;padding:.7rem 1.1rem;border-radius:10px;font-weight:600;z-index:99;box-shadow:var(--shadow-md);opacity:0;transition:opacity .15s';
      document.body.appendChild(t);
    }
    t.textContent = msg; t.style.opacity = '1';
    clearTimeout(toastT); toastT = setTimeout(function () { t.style.opacity = '0'; }, 1800);
  }

  (function writerLock() {
    var LOCK = 'kostka-maraton-writer-lock';
    var myId = 'w' + Math.random().toString(36).slice(2);
    function beat() {
      var raw;
      try { raw = JSON.parse(localStorage.getItem(LOCK) || 'null'); } catch (e) { raw = null; }
      var loser = raw && (Date.now() - raw.ts < 6000) && raw.id !== myId && raw.id < myId;
      var banner = $('#lockWarn');
      if (loser) {
        if (!banner) {
          banner = document.createElement('div');
          banner.id = 'lockWarn';
          banner.style.cssText = 'position:sticky;top:0;z-index:30;background:#E0503A;color:#fff;padding:.6rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:600;text-align:center';
          banner.textContent = '⚠︎ Zdá se, že Tabule je otevřená ve více oknech. Zapisuj jen v jednom — jinak hrozí přepisování bodů (jako loni). Ostatní okna s Tabulí zavři (Leaderboard nevadí).';
          $('.app').insertBefore(banner, $('.summary'));
        }
      } else {
        if (banner) banner.remove();
        try { localStorage.setItem(LOCK, JSON.stringify({ id: myId, ts: Date.now() })); } catch (e) {}
      }
    }
    beat();
    setInterval(beat, 2000);
  })();

  S.subscribe(function (state, origin) {
    render(state, origin);
    renderRaceBtn();
  });

  var lastSyncWarn = '';
  S.onSync(function (st) {
    var dot = $('#syncDot'), txt = $('#syncText'), box = dot.parentNode;
    dot.className = 'dot' + (st.status === 'saving' || st.status === 'connecting' ? ' saving'
      : st.status === 'online' ? '' : st.status === 'conflict' ? ' remote' : ' offline');
    box.classList.toggle('warn', st.status === 'offline' || st.status === 'auth');
    box.title = st.message || '';
    txt.textContent =
      st.status === 'online' ? 'Online · uloženo ' + fmtTime(st.at)
      : st.status === 'saving' ? 'Ukládám online…'
      : st.status === 'connecting' ? 'Připojuji…'
      : st.status === 'conflict' ? 'Načteno z jiného zařízení'
      : st.status === 'auth' ? 'Odhlášeno – přihlas se'
      : 'Offline – ukládá se jen sem';
    if (st.message && st.message !== lastSyncWarn) toast(st.message);
    lastSyncWarn = st.message;
  });

  render(S.state);
  renderRaceBtn();
  S.startSync();
}

/* ============================================================
 * initLeaderboard() — zobrazovací obrazovka (jen čte stav)
 * ========================================================== */
function initLeaderboard() {
  'use strict';
  if (initLeaderboard._done) return; initLeaderboard._done = true;
  var S = window.KMH.init({ writer: false });

  var $ = function (s, r) { return (r || document).querySelector(s); };
  var listInner = $('#listInner');
  var podiumEl = $('#podium');
  var rowMap = {};
  var prevPoints = {};
  var prevRank = {};
  var prevLeader = null;
  var firstRender = true;
  var RANK_WORD = { 1: '1. místo', 2: '2. místo', 3: '3. místo' };

  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  }); }

  function tick() {
    var d = new Date();
    var p = function (n) { return ('0' + n).slice(-2); };
    $('#lbClock').textContent = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());

    var r = S.raceInfo();
    var cd = $('#lbCountdown');
    var fmt = function (ms) {
      return p(Math.floor(ms / 3.6e6)) + ':' + p(Math.floor(ms % 3.6e6 / 6e4)) + ':' + p(Math.floor(ms % 6e4 / 1e3));
    };
    cd.hidden = false;
    cd.classList.remove('live', 'ready');
    if (!r.started) {
      cd.textContent = '⏱ ' + fmt(r.durationMs) + ' · čeká na start';
      cd.classList.add('ready');
    } else if (r.done) {
      cd.textContent = '⏱ DOHRÁNO';
      cd.classList.add('live');
    } else {
      cd.textContent = '⏱ zbývá ' + fmt(r.remainingMs);
      cd.classList.toggle('live', r.remainingMs < 36e5);
    }
  }
  setInterval(tick, 1000); tick();

  function render(state) {
    $('#lbTitle').innerHTML = esc(state.settings.eventName || 'KOSTKA') +
      ' <b>·</b> ' + esc(state.settings.subtitle || '');
    $('#lbEdition').textContent = (state.settings.edition ? state.settings.edition + ' · ' : '') + 'Průběžné pořadí';
    $('#lbFoot').textContent = 'Kostka · maraton deskových her' + (state.settings.edition ? ' · ' + state.settings.edition : '');

    var ranking = S.ranking();
    var hasScores = ranking.some(function (r) { return r.points > 0; });

    if (!ranking.length || !hasScores) {
      podiumEl.hidden = true;
      $('#list').hidden = true;
      $('#lbEmpty').hidden = false;
      rowMap = {};
      listInner.innerHTML = '';
      prevPoints = {}; prevRank = {};
      ranking.forEach(function (r) { prevPoints[r.p.id] = r.points; });
      firstRender = false;
      return;
    }
    $('#lbEmpty').hidden = true;
    $('#list').hidden = false;

    var top = ranking.slice(0, 3);
    var rest = ranking.slice(3);

    renderPodium(top);
    renderList(rest);

    var leader = ranking[0] ? ranking[0].p.id : null;
    if (!firstRender && leader && leader !== prevLeader) celebrate();
    prevLeader = leader;

    prevPoints = {}; prevRank = {};
    ranking.forEach(function (r) { prevPoints[r.p.id] = r.points; prevRank[r.p.id] = r.rank; });
    firstRender = false;
  }

  function renderPodium(top) {
    podiumEl.hidden = false;
    var order = [top[1], top[0], top[2]];
    var slotClass = ['pod--2', 'pod--1', 'pod--3'];
    podiumEl.innerHTML = order.map(function (r, i) {
      if (!r) return '<div class="pod ' + slotClass[i] + '" style="visibility:hidden"></div>';
      var rank = r.rank;
      var bumped = prevPoints[r.p.id] != null && prevPoints[r.p.id] !== r.points && !firstRender;
      return '<div class="pod ' + slotClass[i] + (bumped ? ' bumped' : '') + '" data-id="' + r.p.id + '">' +
        '<div class="badge">' + rank + '</div>' +
        '<div class="rank-word">' + (RANK_WORD[rank] || rank + '. místo') + '</div>' +
        '<div class="name">' + esc(r.name) + '</div>' +
        '<div class="pts">' + r.points + ' <small>b</small></div>' +
        '<div class="bar"></div>' +
      '</div>';
    }).join('');
  }

  function renderList(rows) {
    var listEl = $('#list');
    var narrow = window.matchMedia('(max-width: 760px)').matches;
    var cols = narrow ? 1 : rows.length > 24 ? 3 : rows.length > 12 ? 2 : 1;
    var perCol = Math.ceil(rows.length / cols);
    var rh = narrow || perCol <= 8 ? 1 : Math.max(0.5, 8 / perCol);
    listEl.style.setProperty('--cols', cols);
    listEl.style.setProperty('--rows', perCol);
    listEl.style.setProperty('--rh', rh.toFixed(3));

    var firstRects = {};
    Object.keys(rowMap).forEach(function (id) {
      firstRects[id] = rowMap[id].getBoundingClientRect();
    });

    var seen = {};
    rows.forEach(function (r) {
      seen[r.p.id] = true;
      var el = rowMap[r.p.id];
      if (!el) {
        el = document.createElement('div');
        el.className = 'rowx';
        el.dataset.id = r.p.id;
        rowMap[r.p.id] = el;
      }
      var oldRank = prevRank[r.p.id];
      var mv = 'flat', arrow = '•';
      if (oldRank != null && oldRank !== r.rank) {
        if (r.rank < oldRank) { mv = 'up'; arrow = '▲'; }
        else { mv = 'down'; arrow = '▼'; }
      }
      el.innerHTML =
        '<span class="rk">' + r.rank + '</span>' +
        '<span class="nm">' + esc(r.name) + '</span>' +
        '<span class="ps"><span class="mv ' + mv + '">' + arrow + '</span>' + r.points + '</span>';
      listInner.appendChild(el);
    });

    Object.keys(rowMap).forEach(function (id) {
      if (!seen[id]) {
        var el = rowMap[id];
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'scale(.9)';
        setTimeout(function () { el.remove(); }, 320);
        delete rowMap[id];
      }
    });

    rows.forEach(function (r) {
      var el = rowMap[r.p.id];
      var last = el.getBoundingClientRect();
      var first = firstRects[r.p.id];
      if (first) {
        var dx = first.left - last.left;
        var dy = first.top - last.top;
        if (dx || dy) {
          el.style.transition = 'none';
          el.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
          el.getBoundingClientRect();
          el.style.transition = 'transform .55s cubic-bezier(.22,1,.36,1)';
          el.style.transform = '';
        }
      } else {
        el.style.transition = 'none';
        el.style.opacity = '0';
        el.style.transform = 'translateY(10px)';
        el.getBoundingClientRect();
        el.style.transition = 'opacity .4s, transform .4s';
        el.style.opacity = ''; el.style.transform = '';
      }
      if (prevPoints[r.p.id] != null && prevPoints[r.p.id] !== r.points && !firstRender) {
        el.classList.remove('pts-bump'); void el.offsetWidth; el.classList.add('pts-bump');
      }
    });
  }

  function celebrate() {
    var wrap = document.createElement('div');
    wrap.className = 'confetti';
    var colors = ['#00BBD6', '#FFC24B', '#005466', '#E08A4B'];
    for (var i = 0; i < 70; i++) {
      var s = document.createElement('i');
      s.style.left = Math.random() * 100 + 'vw';
      s.style.background = colors[i % colors.length];
      s.style.animationDuration = (1.6 + Math.random() * 1.8) + 's';
      s.style.animationDelay = (Math.random() * .5) + 's';
      wrap.appendChild(s);
    }
    document.body.appendChild(wrap);
    setTimeout(function () { wrap.remove(); }, 3800);
  }

  (function themeToggle() {
    var KEY_T = 'kostka-maraton-lb-theme';
    var night = false;
    try { night = localStorage.getItem(KEY_T) === 'night'; } catch (e) {}
    function apply() {
      document.body.classList.toggle('lb-night', night);
      $('#lbTheme').textContent = night ? '☀ Denní režim' : '☾ Noční režim';
    }
    function flip() {
      night = !night; apply();
      try { localStorage.setItem(KEY_T, night ? 'night' : 'day'); } catch (e) {}
    }
    $('#lbTheme').addEventListener('click', flip);
    document.addEventListener('keydown', function (e) { if (e.key === 'n' || e.key === 'N') flip(); });
    apply();
  })();

  S.subscribe(function (state) { render(state); });
  render(S.state);

  S.onSync(function (st) {
    var bad = st.status === 'offline' || st.status === 'auth';
    $('#lbFoot').classList.toggle('lb-offline', bad);
    $('#lbFoot').setAttribute('data-msg', bad ? '⚠ ' + (st.status === 'auth' ? 'odhlášeno z adminu' : 'bez spojení – zobrazuji poslední známý stav') : '');
  });
  S.startSync();
  // Okno ve stejném prohlížeči jako Tabule dostane změny i přímo (BroadcastChannel/storage).
  setInterval(function () {
    try { S.reload(); } catch (e) {}
  }, 2000);
  window.addEventListener('resize', function () { render(S.state); });
}

/* ============================================================
 * router
 * ========================================================== */
(function boot() {
  function route() {
    var h = (location.hash || '').replace(/^#\/?/, '').toLowerCase();
    if (h.indexOf('tabule') === 0) { document.body.className = 'admin-mode'; initAdmin(); }
    else if (h.indexOf('leaderboard') === 0 || h.indexOf('board') === 0) { document.body.className = 'lb-mode'; initLeaderboard(); }
    else { document.body.className = 'launch-mode'; }
  }
  route();
  /* Tabule (zapisovatel) a Leaderboard (jen čte) nesmí běžet v jednom okně zároveň –
     když už jeden z nich běží, přepnutí pohledu znamená čisté načtení stránky. */
  window.addEventListener('hashchange', function () {
    if (initAdmin._done || initLeaderboard._done) { location.reload(); return; }
    route(); window.scrollTo(0, 0);
  });
})();
</script>
  </body>
</html>
