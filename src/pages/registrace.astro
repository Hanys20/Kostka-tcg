---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registrace">
  <section class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-4 py-16">
    <h1 class="text-3xl font-black text-kostka-dark">Vytvořit účet</h1>
    <p class="mt-2 text-kostka-dark/60">
      Účet si založíte za minutu – uvidíte historii turnajů, umístění a achievementy.
    </p>

    <form class="mt-8 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm font-semibold text-kostka-dark" for="jmeno">Jméno</label>
          <input
            id="jmeno"
            type="text"
            placeholder="Jan"
            class="mt-1 w-full rounded-xl border border-kostka-dark/15 px-4 py-2.5 outline-none focus:border-kostka-cyan"
          />
        </div>
        <div>
          <label class="text-sm font-semibold text-kostka-dark" for="nick">Nick</label>
          <input
            id="nick"
            type="text"
            placeholder="JanTCG"
            class="mt-1 w-full rounded-xl border border-kostka-dark/15 px-4 py-2.5 outline-none focus:border-kostka-cyan"
          />
        </div>
      </div>
      <div>
        <label class="text-sm font-semibold text-kostka-dark" for="email">E-mail</label>
        <input
          id="email"
          type="email"
          placeholder="jan@email.cz"
          class="mt-1 w-full rounded-xl border border-kostka-dark/15 px-4 py-2.5 outline-none focus:border-kostka-cyan"
        />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm font-semibold text-kostka-dark" for="telefon">Telefon</label>
          <input
            id="telefon"
            type="tel"
            placeholder="+420 123 456 789"
            class="mt-1 w-full rounded-xl border border-kostka-dark/15 px-4 py-2.5 outline-none focus:border-kostka-cyan"
          />
        </div>
        <div>
          <label class="text-sm font-semibold text-kostka-dark" for="narozeni">Datum narození</label>
          <input
            id="narozeni"
            type="date"
            class="mt-1 w-full rounded-xl border border-kostka-dark/15 px-4 py-2.5 outline-none focus:border-kostka-cyan"
          />
        </div>
      </div>
      <div>
        <label class="text-sm font-semibold text-kostka-dark" for="password">Heslo</label>
        <input
          id="password"
          type="password"
          placeholder="••••••••"
          class="mt-1 w-full rounded-xl border border-kostka-dark/15 px-4 py-2.5 outline-none focus:border-kostka-cyan"
        />
      </div>
      <label class="flex items-start gap-2 text-xs text-kostka-dark/60">
        <input type="checkbox" class="mt-0.5" />
        Souhlasím se <a href="/gdpr" class="font-semibold text-kostka-cyan hover:underline">zpracováním osobních údajů</a>.
      </label>
      <button
        type="submit"
        class="w-full rounded-full bg-kostka-cyan px-6 py-3 font-semibold text-white hover:opacity-90"
      >
        Vytvořit účet
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-kostka-dark/60">
      Už máte účet? <a href="/prihlaseni" class="font-semibold text-kostka-cyan hover:underline">Přihlaste se</a>
    </p>
  </section>
</Layout>
