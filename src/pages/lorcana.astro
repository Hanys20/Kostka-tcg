---
import Layout from "../layouts/Layout.astro";
import PublicLeagueBoard from "../components/leaderboard/PublicLeagueBoard.astro";

// Žebříček se čte živě ze Supabase, ať se úpravy z administrace propíšou hned.
export const prerender = false;
---

<Layout title="Lorcana | KOSTKA TCG">
  <section class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-purple">Hra</p>
    <h1 class="mt-3 text-4xl font-black uppercase text-white md:text-5xl">Lorcana</h1>
    <p class="mt-5 max-w-2xl text-white/65">
      Lorcana je pro nás jednou z hlavních herních linií. V herně pořádáme turnaje, ligy a
      pravidelné společné hraní pro hráče, kteří chtějí hrát s přátelskou komunitou.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/turnaje" class="rounded-full bg-kostka-purple px-6 py-3 text-sm font-semibold uppercase tracking-wide text-kostka-bg">Zobrazit termíny</a>
      <a href="/kontakt" class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white">Kontaktovat nás</a>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 md:pb-24">
    <PublicLeagueBoard game="Lorcana" />
  </section>
</Layout>
