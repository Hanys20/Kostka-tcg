---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import TournamentCard from "../components/tournaments/TournamentCard.astro";
import PastTournamentCard from "../components/tournaments/PastTournamentCard.astro";
import { upcomingTournaments, pastTournaments } from "../data/tournaments";

import teamProfile from "../assets/gallery/team-profile.jpg";
import teamCouch from "../assets/gallery/team-couch.jpg";
import teamTower from "../assets/gallery/team-tower.jpg";
import gamesStack from "../assets/gallery/games-stack.jpg";
import cardGame from "../assets/gallery/card-game.jpg";
import teamSofa from "../assets/gallery/team-sofa.jpg";
import heroBoard from "../assets/gallery/hero-board.jpg";
import teamGroup from "../assets/gallery/team-group.jpg";

const games = [
  { name: "Lorcana", logo: "/images/games/lorcana.png" },
  { name: "Pokémon TCG", logo: "/images/games/pokemon-tcg.svg" },
  { name: "Riftbound", logo: "/images/games/riftbound.png" },
];

const usps = [
  {
    title: "Přátelská atmosféra",
    text: "Herna, kde je každý vítán – bez zbytečné soutěživosti mimo stůl.",
    icon: "/images/icons/dice_152508.svg",
  },
  {
    title: "Lepší ceny",
    text: "Karty, boostery a účast na turnajích za ceny, které dávají smysl.",
    icon: "/images/icons/diamond_9210709.svg",
  },
  {
    title: "Turnaje a liga",
    text: "Pravidelná liga, jednorázové turnaje i prerelease nových sad.",
    icon: "/images/icons/cup_14510402.svg",
  },
  {
    title: "Komunita hráčů",
    text: "Spojujeme hráče Lorcany, Pokémonu i Riftboundu v Ostravě.",
    icon: "/images/icons/cards_8531719.svg",
  },
];

const aboutPoints = [
  "Osobní přístup a férové jednání",
  "Skvělá dostupnost v Ostravě-Zábřehu",
  "Místo, kde se z hráčů stávají přátelé",
];

const faqPreview = [
  {
    q: "Jak zarezervuji místo na turnaji?",
    a: "Na stránce Turnaje vyberte termín a odešlete rezervaci – stačí jméno, e-mail a nick, přihlášení uživatelé mají údaje předvyplněné.",
  },
  {
    q: "Musím platit předem?",
    a: "Ne, účastnický poplatek se platí až na místě před začátkem turnaje.",
  },
  {
    q: "Jaký je rozdíl mezi ligou a turnajem?",
    a: "Liga se hraje pravidelně (každý týden), turnaje jsou jednorázové akce a prerelease nových sad.",
  },
];
---

<Layout title="Herna pro hráče, od hráčů pro hráče">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-32 right-0 h-[32rem] w-[32rem] rounded-full bg-kostka-cyan/20 blur-[120px]"></div>

    <div class="relative mx-auto grid max-w-6xl items-stretch gap-12 px-4 pb-16 pt-16 md:pb-24 md:pt-20 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="h-[3px] w-14 flex-none rounded-full bg-kostka-cyan"></span>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-cyan">
            Herna pro hráče TCG v Ostravě
          </p>
        </div>
        <h1 class="mt-5 text-5xl font-black uppercase leading-[1.05] tracking-tight text-white md:text-6xl">
          Od hráčů<br />
          <span class="text-kostka-cyan">pro hráče.</span>
        </h1>
        <p class="mt-6 max-w-md text-lg text-white/70">
          Místo, kde se potkávají hráči TCG. Turnaje, ligy, nové přátelství
          a skvělá atmosféra v Ostravě.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/turnaje"
            class="rounded-full bg-kostka-cyan px-8 py-3 text-sm font-semibold uppercase tracking-wide text-kostka-bg hover:opacity-90"
          >
            Nadcházející turnaje
          </a>
          <a
            href="/o-nas"
            class="rounded-full border border-white/20 px-8 py-3 text-sm font-semibold uppercase tracking-wide text-white hover:border-kostka-cyan hover:text-kostka-cyan"
          >
            Jak to funguje
          </a>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          {
            games.map((game) => (
              <span class="flex h-12 items-center rounded-xl bg-white px-4 shadow-lg shadow-black/20">
                <img src={game.logo} alt={game.name} class="h-6 w-auto object-contain sm:h-7" />
              </span>
            ))
          }
        </div>
      </div>

      <div class="mx-auto w-full max-w-xl lg:mx-0 lg:h-full lg:max-w-none">
        <Image
          src={teamGroup}
          alt="Tým KOSTKA TCG s deskovými hrami"
          class="h-72 w-full rounded-2xl object-cover sm:h-96 lg:h-full"
          widths={[500, 900, 1300]}
          sizes="(min-width: 1024px) 36rem, 90vw"
          loading="eager"
        />
      </div>
    </div>

    <!-- USP strip -->
    <div class="relative mx-auto max-w-6xl px-4 pb-16 md:pb-24">
      <div class="grid gap-8 rounded-2xl border border-white/10 bg-kostka-surface/60 p-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          usps.map((item) => (
            <div>
              <img src={item.icon} alt="" class="h-8 w-8" />
              <h3 class="mt-4 font-bold text-white">{item.title}</h3>
              <p class="mt-2 text-sm text-white/50">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NADCHÁZEJÍCÍ TURNAJE -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">Nadcházející turnaje</p>
        <h2 class="mt-2 text-2xl font-bold text-white md:text-3xl">Co nás čeká?</h2>
      </div>
      <a
        href="/turnaje"
        class="rounded-full border border-white/15 px-5 py-2 text-sm font-semibold text-white/80 hover:border-kostka-cyan hover:text-kostka-cyan"
      >
        Všechny turnaje →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {upcomingTournaments.slice(0, 3).map((event) => <TournamentCard event={event} />)}
    </div>
    <p class="mt-8 flex items-center justify-center gap-2 text-center text-sm text-white/40">
      <img src="/images/icons/calendar.svg" alt="" class="h-4 w-4 flex-none" />
      Pravidelně přidáváme nové turnaje a ligy. Sledujte nás a buďte u toho!
    </p>
  </section>

  <!-- O NÁS -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <Image
        src={teamProfile}
        alt="Herna KOSTKA TCG"
        class="w-full rounded-2xl object-cover"
        widths={[400, 800]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">O nás</p>
        <h2 class="mt-2 text-2xl font-bold text-white md:text-3xl">
          Herna pro hráče, od hráčů pro hráče.
        </h2>
        <p class="mt-4 text-white/60">
          KOSTKA TCG vznikla z vášně pro trading card games a komunitu, která kolem nich vzniká.
          Chceme vytvořit místo, kam se budete rádi vracet – na turnaje, ligy i jen tak si zahrát.
        </p>
        <ul class="mt-6 space-y-3">
          {
            aboutPoints.map((point) => (
              <li class="flex items-center gap-3 text-sm text-white/70">
                <span class="grid h-5 w-5 flex-none place-items-center rounded-full bg-kostka-cyan/15 text-kostka-cyan">
                  <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3.5,8.5 6.5,11.5 12.5,4.5" />
                  </svg>
                </span>
                {point}
              </li>
            ))
          }
        </ul>
        <a
          href="/o-nas"
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold uppercase tracking-wide text-white hover:border-kostka-cyan hover:text-kostka-cyan"
        >
          Zjistit více o nás →
        </a>
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="bg-kostka-surface/40 py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">Komunita</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-white md:text-3xl">Ze hry i z turnajů</h2>
        <p class="max-w-sm text-sm text-white/50">Zákulisí turnajů, novinky a atmosféra herny.</p>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
        <Image src={cardGame} alt="Hráčka u karetní hry v KOSTKA TCG" class="col-span-2 row-span-2 h-full w-full rounded-2xl object-cover" widths={[400, 800]} sizes="(min-width: 768px) 400px, 50vw" />
        <Image src={teamTower} alt="Tým KOSTKA TCG s věží krabic her" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
        <Image src={gamesStack} alt="Naskládané krabice her v herně" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
        <Image src={teamCouch} alt="Tým KOSTKA TCG na gauči s hrami" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
        <Image src={teamSofa} alt="Tým KOSTKA TCG při turnaji" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
      </div>
    </div>
  </section>

  <!-- PROBĚHLÉ TURNAJE -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Předešlé turnaje</h2>
      <a href="/turnaje?tab=probehle" class="text-sm font-semibold text-kostka-cyan hover:underline">
        Celá historie →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pastTournaments.map((event) => <PastTournamentCard event={event} />)}
    </div>
  </section>

  <!-- FAQ TEASER -->
  <section class="bg-kostka-surface/40 py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Časté dotazy</h2>
      <div class="mt-8 divide-y divide-white/10">
        {
          faqPreview.map((item) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-semibold text-white marker:content-none">
                {item.q}
              </summary>
              <p class="mt-2 text-white/60">{item.a}</p>
            </details>
          ))
        }
      </div>
      <a href="/faq" class="mt-6 inline-block text-sm font-semibold text-kostka-cyan hover:underline">
        Všechny otázky →
      </a>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid overflow-hidden rounded-3xl border border-white/10 bg-kostka-surface">
      <Image
        src={heroBoard}
        alt=""
        class="pointer-events-none col-start-1 row-start-1 h-64 w-full object-cover sm:h-80 md:h-96"
        widths={[600, 1200]}
        sizes="100vw"
      />
      <div class="pointer-events-none col-start-1 row-start-1 bg-gradient-to-r from-kostka-surface from-20% via-kostka-surface/90 via-60% to-kostka-surface/10"></div>
      <div class="relative col-start-1 row-start-1 flex flex-col justify-center p-10 md:p-14">
        <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">Připraven/a zahrát?</p>
        <h2 class="mt-2 max-w-md text-3xl font-black text-white md:text-4xl">
          Zarezervuj si místo na dalším turnaji.
        </h2>
        <a
          href="/turnaje"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-kostka-cyan px-8 py-3 text-sm font-semibold uppercase tracking-wide text-kostka-bg hover:opacity-90"
        >
          Zarezervovat termín →
        </a>
      </div>
    </div>
  </section>
</Layout>
