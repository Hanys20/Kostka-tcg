---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Herna pro hráče, od hráčů pro hráče">
  <section class="mx-auto max-w-6xl px-4 py-20 text-center">
    <h1 class="text-4xl font-black tracking-tight text-kostka-dark md:text-6xl">
      Herna pro hráče, <span class="text-kostka-cyan">od hráčů pro hráče</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-kostka-dark/70">
      Turnaje a ligy Lorcana, Pokémon a Riftbound v Ostravě. Lepší ceny, osobní přístup,
      přátelská atmosféra.
    </p>
    <div class="mt-10 flex justify-center gap-4">
      <a
        href="/turnaje"
        class="rounded-full bg-kostka-cyan px-8 py-3 font-semibold text-white hover:opacity-90"
      >
        Zarezervovat termín turnaje
      </a>
      <a
        href="/o-nas"
        class="rounded-full border border-kostka-dark/20 px-8 py-3 font-semibold text-kostka-dark hover:border-kostka-cyan hover:text-kostka-cyan"
      >
        O nás
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-kostka-dark">Nadcházející turnaje a ligy</h2>
    <p class="mt-2 text-kostka-dark/60">
      Zde se po napojení na Supabase zobrazí přehled nadcházejících termínů (liga i turnaje).
    </p>
  </section>
</Layout>
