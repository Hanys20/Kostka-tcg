---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import TournamentCard from "../components/tournaments/TournamentCard.astro";
import PastTournamentCard from "../components/tournaments/PastTournamentCard.astro";
import { getUpcomingTournaments, getPastTournaments } from "../data/tournaments";

export const prerender = false;

const upcomingTournaments = await getUpcomingTournaments();
const pastTournaments = await getPastTournaments();

import teamProfile from "../assets/gallery/team-profile.jpg";
import teamCouch from "../assets/gallery/team-couch.jpg";
import teamTower from "../assets/gallery/team-tower.jpg";
import gamesStack from "../assets/gallery/games-stack.jpg";
import cardGame from "../assets/gallery/card-game.jpg";
import teamSofa from "../assets/gallery/team-sofa.jpg";
import heroBoard from "../assets/gallery/hero-board.jpg";
import teamGroup from "../assets/gallery/team-group.jpg";

const games = [
  { id: "lorcana", name: "Lorcana", logo: "/images/games/lorcana.png", href: "/lorcana" },
  { id: "pokemon", name: "Pokémon TCG", logo: "/images/games/pokemon-tcg.webp", href: "/pokemon-tcg" },
  { id: "riftbound", name: "Riftbound", logo: "/images/games/riftbound.png", href: "/riftbound" },
];

const usps = [
  {
    title: "Přátelská atmosféra",
    text: "Herna, kde je každý vítán – bez zbytečné soutěživosti mimo stůl.",
  },
  {
    title: "Lepší ceny",
    text: "Karty, boostery a účast na turnajích za ceny, které dávají smysl.",
  },
  {
    title: "Turnaje a liga",
    text: "Pravidelná liga, jednorázové turnaje i prerelease nových sad.",
  },
  {
    title: "Komunita hráčů",
    text: "Spojujeme hráče Lorcany, Pokémonu i Riftboundu v Ostravě.",
  },
];

const aboutPoints = [
  "Osobní přístup a férové jednání",
  "Skvělá dostupnost v Ostravě-Zábřehu",
  "Místo, kde se z hráčů stávají přátelé",
];

const faqPreview = [
  {
    q: "Jak zarezervuji místo na turnaji?",
    a: "Na stránce Turnaje vyberte termín a odešlete rezervaci – stačí jméno, e-mail a přezdívka, přihlášení uživatelé mají údaje předvyplněné.",
  },
  {
    q: "Musím platit předem?",
    a: "Ne, účastnický poplatek se platí až na místě před začátkem turnaje.",
  },
  {
    q: "Jaký je rozdíl mezi ligou a turnajem?",
    a: "Liga se hraje pravidelně (každý týden), turnaje jsou jednorázové akce a prerelease nových sad.",
  },
];
---

<Layout title="Herna pro hráče, od hráčů pro hráče">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-32 right-0 h-[32rem] w-[32rem] rounded-full bg-kostka-cyan/20 blur-[120px]"></div>

    <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-16 md:pb-24 md:pt-20">
      <div class="flex items-center gap-3">
        <span class="h-[3px] w-14 flex-none rounded-full bg-kostka-cyan"></span>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-kostka-cyan">
          Herna pro hráče TCG v Ostravě
        </p>
      </div>

      <div class="mt-5 max-w-4xl">
        <h1 class="text-5xl font-black uppercase leading-[1.05] tracking-tight text-white md:text-6xl lg:text-[5.4rem]">
          Od hráčů<br />
          <span class="text-kostka-cyan">pro hráče.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base text-white/70 sm:text-lg">
          Vítáme hráče Lorcany, Pokémonu i Riftboundu. V KOSTKA TCG najdete
          pravidelné ligy, turnaje, přátelskou komunitu a místo, kam se rádi vracíte.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/turnaje"
          class="rounded-full bg-kostka-cyan px-8 py-3 text-sm font-semibold uppercase tracking-wide text-kostka-bg hover:opacity-90"
        >
          Nadcházející turnaje
        </a>
        <a
          href="/o-nas"
          class="rounded-full border border-white/20 px-8 py-3 text-sm font-semibold uppercase tracking-wide text-white hover:border-kostka-cyan hover:text-kostka-cyan"
        >
          Jak to funguje
        </a>
      </div>

      <div class="mt-12">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-white/55">Vyber si svou hru</p>
          <p class="text-sm text-white/50">Lorcana, Pokémon TCG i Riftbound – vše na jednom místě.</p>
        </div>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {
            games.map((game) => (
              <a
                href={game.href}
                aria-label={game.name}
                class={`game-card game-card--${game.id} group relative flex h-40 items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-kostka-surface/50 p-6 transition duration-300 hover:-translate-y-1 sm:h-44`}
              >
                <span class="game-card__glow pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

                {game.id === "lorcana" && (
                  <span class="pointer-events-none absolute inset-0">
                    <span class="ink-spark ink-spark--1" />
                    <span class="ink-spark ink-spark--2" />
                    <span class="ink-spark ink-spark--3" />
                    <span class="ink-spark ink-spark--4" />
                    <span class="ink-spark ink-spark--5" />
                  </span>
                )}

                {game.id === "pokemon" && (
                  <span class="pointer-events-none absolute inset-0 pokemon-bolt" />
                )}

                {game.id === "riftbound" && (
                  <span class="pointer-events-none absolute inset-0 rift-tear">
                    <span class="rift-tear__ring" />
                    <span class="rift-tear__crack" />
                  </span>
                )}

                <img
                  src={game.logo}
                  alt={game.name}
                  class="game-card__logo relative z-10 max-h-20 w-auto object-contain transition duration-500 ease-out group-hover:scale-110 sm:max-h-24"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <style>
      .game-card {
        isolation: isolate;
      }

      .game-card__glow {
        background: radial-gradient(circle at 50% 45%, var(--glow-color, rgba(0, 180, 212, 0.3)), transparent 65%);
      }

      /* Lorcana – magický inkoust, jiskřičky vzplanou při hoveru */
      .game-card--lorcana {
        --glow-color: rgba(167, 139, 250, 0.35);
      }
      .game-card--lorcana:hover {
        border-color: rgba(167, 139, 250, 0.55);
        box-shadow: 0 0 32px rgba(167, 139, 250, 0.22);
      }
      .ink-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 9999px;
        background: radial-gradient(circle, #f4d9a0 0%, rgba(244, 217, 160, 0) 70%);
        opacity: 0;
      }
      .game-card--lorcana:hover .ink-spark {
        animation: ink-spark-float 2s ease-in-out infinite;
      }
      .ink-spark--1 { top: 22%; left: 18%; animation-delay: 0s; }
      .ink-spark--2 { top: 65%; left: 28%; animation-delay: 0.35s; }
      .ink-spark--3 { top: 28%; left: 78%; animation-delay: 0.7s; }
      .ink-spark--4 { top: 70%; left: 72%; animation-delay: 1.05s; }
      .ink-spark--5 { top: 48%; left: 50%; animation-delay: 1.4s; }
      @keyframes ink-spark-float {
        0% { opacity: 0; transform: translateY(8px) scale(0.4); }
        35% { opacity: 1; transform: translateY(-2px) scale(1.3); }
        100% { opacity: 0; transform: translateY(-18px) scale(0.3); }
      }

      /* Pokémon TCG – elektrický záblesk přeletí kartou */
      .game-card--pokemon {
        --glow-color: rgba(255, 209, 0, 0.32);
      }
      .game-card--pokemon:hover {
        border-color: rgba(255, 209, 0, 0.55);
        box-shadow: 0 0 32px rgba(255, 209, 0, 0.2);
      }
      .pokemon-bolt {
        opacity: 0;
        background: linear-gradient(
          115deg,
          transparent 42%,
          rgba(255, 209, 0, 0.55) 48%,
          rgba(255, 255, 255, 0.95) 50%,
          rgba(255, 61, 0, 0.5) 52%,
          transparent 58%
        );
        background-size: 260% 260%;
        background-position: 130% -20%;
      }
      .game-card--pokemon:hover .pokemon-bolt {
        animation: pokemon-bolt-sweep 1.1s ease-in-out infinite;
      }
      @keyframes pokemon-bolt-sweep {
        0% { opacity: 0; background-position: 130% -20%; }
        12% { opacity: 1; }
        50% { opacity: 0.9; background-position: -30% 110%; }
        65% { opacity: 0; }
        100% { opacity: 0; background-position: -30% 110%; }
      }
      .game-card--pokemon:hover .game-card__logo {
        animation: pokemon-logo-shake 0.5s ease-in-out 1;
      }
      @keyframes pokemon-logo-shake {
        0%, 100% { transform: scale(1.1) rotate(0deg); }
        25% { transform: scale(1.1) rotate(-3deg); }
        75% { transform: scale(1.1) rotate(3deg); }
      }

      /* Riftbound – arkánní trhlina se otevře kolem loga */
      .game-card--riftbound {
        --glow-color: rgba(10, 200, 185, 0.3);
      }
      .game-card--riftbound:hover {
        border-color: rgba(10, 200, 185, 0.5);
        box-shadow: 0 0 32px rgba(10, 200, 185, 0.2);
      }
      .rift-tear__ring {
        position: absolute;
        inset: -30%;
        background: conic-gradient(
          from 0deg,
          transparent 0deg,
          rgba(10, 200, 185, 0.45) 35deg,
          transparent 90deg,
          rgba(193, 71, 233, 0.4) 200deg,
          transparent 260deg
        );
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .game-card--riftbound:hover .rift-tear__ring {
        opacity: 1;
        animation: rift-ring-spin 3.2s linear infinite;
      }
      @keyframes rift-ring-spin {
        to { transform: rotate(360deg); }
      }
      .rift-tear__crack {
        position: absolute;
        top: 50%;
        left: 8%;
        right: 8%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(10, 200, 185, 0.9), rgba(193, 71, 233, 0.9), transparent);
        opacity: 0;
        transform: scaleX(0);
        transition: transform 0.5s ease, opacity 0.5s ease;
      }
      .game-card--riftbound:hover .rift-tear__crack {
        opacity: 1;
        transform: scaleX(1);
      }

      @media (prefers-reduced-motion: reduce) {
        .ink-spark,
        .pokemon-bolt,
        .rift-tear__ring,
        .game-card__logo {
          animation: none !important;
        }
      }
    </style>

    <!-- USP strip -->
    <div class="relative mx-auto max-w-6xl px-4 pb-16 md:pb-24">
      <div class="grid gap-4 rounded-2xl border border-white/10 bg-kostka-surface/60 p-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          usps.map((item) => (
            <div class="rounded-2xl border border-white/6 bg-white/[0.02] p-5 transition duration-300 hover:border-kostka-cyan/50 hover:bg-kostka-cyan/[0.04]">
              <div class="h-px w-10 rounded-full bg-kostka-cyan"></div>
              <h3 class="mt-4 text-lg font-bold text-white">{item.title}</h3>
              <p class="mt-2 text-sm text-white/55">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NADCHÁZEJÍCÍ TURNAJE -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">Nadcházející turnaje</p>
        <h2 class="mt-2 text-2xl font-bold text-white md:text-3xl">Co nás čeká?</h2>
        <p class="mt-2 max-w-2xl text-sm text-white/55 md:text-base">
          Pravidelné ligy, jednorázové turnaje a prerelease nových sad. Všechny termíny najdeš v jednom přehledu.
        </p>
      </div>
      <a
        href="/turnaje"
        class="rounded-full border border-white/15 px-5 py-2 text-sm font-semibold text-white/80 hover:border-kostka-cyan hover:text-kostka-cyan"
      >
        Všechny turnaje →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {upcomingTournaments.length
        ? upcomingTournaments.slice(0, 3).map((event) => <TournamentCard event={event} />)
        : <p class="text-sm text-white/50">Zatím tu nejsou žádné naplánované termíny.</p>}
    </div>
    <p class="mt-8 flex items-center justify-center gap-2 text-center text-sm text-white/40">
      <img src="/images/icons/calendar.svg" alt="" class="h-4 w-4 flex-none" />
      Pravidelně přidáváme nové turnaje a ligy. Sledujte nás a buďte u toho!
    </p>
  </section>

  <!-- O NÁS -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <Image
        src={teamProfile}
        alt="Herna KOSTKA TCG"
        class="w-full rounded-2xl object-cover"
        widths={[400, 800]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">O nás</p>
        <h2 class="mt-2 text-2xl font-bold text-white md:text-3xl">
          Herna pro hráče, od hráčů pro hráče.
        </h2>
        <p class="mt-4 text-base text-white/60">
          KOSTKA TCG vznikla z vášně pro trading card games a komunitu, která kolem nich vzniká.
          Chceme vytvořit místo, kam se budete rádi vracet – na turnaje, ligy, prerelease i jen tak si zahrát.
        </p>
        <ul class="mt-6 space-y-3">
          {
            aboutPoints.map((point) => (
              <li class="flex items-center gap-3 text-sm text-white/70">
                <span class="grid h-5 w-5 flex-none place-items-center rounded-full bg-kostka-cyan/15 text-kostka-cyan">
                  <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3.5,8.5 6.5,11.5 12.5,4.5" />
                  </svg>
                </span>
                {point}
              </li>
            ))
          }
        </ul>
        <a
          href="/o-nas"
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold uppercase tracking-wide text-white hover:border-kostka-cyan hover:text-kostka-cyan"
        >
          Zjistit více o nás →
        </a>
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="bg-kostka-surface/40 py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">Komunita</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-white md:text-3xl">Ze hry i z turnajů</h2>
        <p class="max-w-sm text-sm text-white/50">Zákulisí turnajů, novinky a atmosféra herny.</p>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
        <Image src={cardGame} alt="Hráčka u karetní hry v KOSTKA TCG" class="col-span-2 row-span-2 h-full w-full rounded-2xl object-cover" widths={[400, 800]} sizes="(min-width: 768px) 400px, 50vw" />
        <Image src={teamTower} alt="Tým KOSTKA TCG s věží krabic her" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
        <Image src={gamesStack} alt="Naskládané krabice her v herně" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
        <Image src={teamCouch} alt="Tým KOSTKA TCG na gauči s hrami" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
        <Image src={teamSofa} alt="Tým KOSTKA TCG při turnaji" class="h-full w-full rounded-2xl object-cover" widths={[300, 600]} sizes="300px" />
      </div>
    </div>
  </section>

  <!-- PROBĚHLÉ TURNAJE -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Předešlé turnaje</h2>
      <a href="/turnaje?tab=probehle" class="text-sm font-semibold text-kostka-cyan hover:underline">
        Celá historie →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pastTournaments.length
        ? pastTournaments.map((event) => <PastTournamentCard event={event} />)
        : <p class="text-sm text-white/50">Zatím tu nejsou žádné proběhlé turnaje.</p>}
    </div>
  </section>

  <!-- FAQ TEASER -->
  <section class="bg-kostka-surface/40 py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Časté dotazy</h2>
      <div class="mt-8 divide-y divide-white/10">
        {
          faqPreview.map((item) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-semibold text-white marker:content-none">
                {item.q}
              </summary>
              <p class="mt-2 text-white/60">{item.a}</p>
            </details>
          ))
        }
      </div>
      <a href="/faq" class="mt-6 inline-block text-sm font-semibold text-kostka-cyan hover:underline">
        Všechny otázky →
      </a>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid overflow-hidden rounded-3xl border border-white/10 bg-kostka-surface">
      <Image
        src={heroBoard}
        alt=""
        class="pointer-events-none col-start-1 row-start-1 h-64 w-full object-cover sm:h-80 md:h-96"
        widths={[600, 1200]}
        sizes="100vw"
      />
      <div class="pointer-events-none col-start-1 row-start-1 bg-gradient-to-r from-kostka-surface from-20% via-kostka-surface/90 via-60% to-kostka-surface/10"></div>
      <div class="relative col-start-1 row-start-1 flex flex-col justify-center p-10 md:p-14">
        <p class="text-xs font-semibold uppercase tracking-wide text-kostka-cyan">Připraven/a zahrát?</p>
        <h2 class="mt-2 max-w-md text-3xl font-black text-white md:text-4xl">
          Zarezervuj si místo na dalším turnaji.
        </h2>
        <a
          href="/turnaje"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-kostka-cyan px-8 py-3 text-sm font-semibold uppercase tracking-wide text-kostka-bg hover:opacity-90"
        >
          Zarezervovat termín →
        </a>
      </div>
    </div>
  </section>
</Layout>
