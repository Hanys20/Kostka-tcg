---
import Layout from "../../layouts/Layout.astro";
import { getUpcomingTournaments, getPastTournaments } from "../../data/tournaments";

const upcomingTournaments = await getUpcomingTournaments();
const pastTournaments = await getPastTournaments();

export async function getStaticPaths() {
  return [
    ...upcomingTournaments.map((event) => ({ params: { slug: event.slug }, props: { event, isPast: false } })),
    ...pastTournaments.map((event) => ({ params: { slug: event.slug }, props: { event, isPast: true } })),
  ];
}

const { event, isPast } = Astro.props;
---

<Layout title={event.title}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <a href="/turnaje" class="text-sm font-semibold text-kostka-cyan hover:underline">← Zpět na turnaje</a>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class="rounded-full bg-kostka-cyan/10 px-3 py-1 text-xs font-semibold text-kostka-cyan">
        {event.game}
      </span>
      <span class="text-xs font-semibold uppercase tracking-wide text-white/40">
        {event.type === "league" ? "Liga" : "Turnaj"}
      </span>
    </div>

    <h1 class="mt-3 text-3xl font-black text-white md:text-4xl">{event.title}</h1>
    <p class="mt-2 text-white/60">
      {event.date}{"time" in event ? ` · ${event.time}` : ""} · Dolní 782/65, Ostrava-Jih-Zábřeh
    </p>

    <div class="mt-10 grid gap-10 md:grid-cols-[1fr_320px]">
      <div class="prose prose-invert max-w-none text-white/70">
        <p>
          {isPast
            ? `Turnaj proběhl, zúčastnilo se ${("participants" in event) ? event.participants : ""} hráčů.`
            : "Přihlaste se na turnaj předem – ušetříte čas na místě. Účastnický poplatek se hradí až na místě před začátkem, platební brána se nepoužívá."}
        </p>
        {
          isPast && "winner" in event && (
            <p class="mt-4 flex items-center gap-2 rounded-xl bg-kostka-cyan/10 p-4 font-semibold text-white">
              <img src="/images/icons/trophy.svg" alt="" class="h-5 w-5 flex-none" />
              Vítěz: {event.winner}
            </p>
          )
        }
      </div>

      {
        !isPast && (
          <aside class="h-fit rounded-2xl border border-white/10 bg-kostka-surface p-6">
            <h2 class="font-bold text-white">Rezervace místa</h2>
            <p class="mt-1 text-sm text-white/50">
              Jste přihlášeni? <a href="/prihlaseni" class="font-semibold text-kostka-cyan hover:underline">Přihlaste se</a> a údaje se předvyplní.
            </p>
            <form class="mt-4 space-y-3">
              <input
                type="text"
                placeholder="Jméno a příjmení"
                class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-cyan"
              />
              <input
                type="text"
                placeholder="Nick"
                class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-cyan"
              />
              <input
                type="email"
                placeholder="E-mail"
                class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 outline-none focus:border-kostka-cyan"
              />
              <button
                type="submit"
                class="w-full rounded-full bg-kostka-cyan px-4 py-2.5 text-sm font-semibold text-kostka-bg hover:opacity-90"
              >
                Rezervovat místo
              </button>
            </form>
          </aside>
        )
      }
    </div>
  </section>
</Layout>
