---
import Layout from "../../layouts/Layout.astro";
import { getEventBySlug } from "../../data/tournaments";

export const prerender = false;

const { slug } = Astro.params;
const result = slug ? await getEventBySlug(slug) : null;

if (!result) {
  return Astro.redirect("/turnaje");
}

const { event, isPast } = result;
const showExternalRegistration = !isPast && "registrationUrl" in event && Boolean(event.registrationUrl);
const spotsTaken = "spotsTaken" in event ? event.spotsTaken : 0;
const spotsTotal = "spotsTotal" in event ? event.spotsTotal : 0;
const spotsLeft = spotsTotal - spotsTaken;
const percentFull = spotsTotal ? Math.round((spotsTaken / spotsTotal) * 100) : 0;
---

<Layout title={event.title}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <a href="/turnaje" class="text-sm font-semibold text-kostka-purple hover:underline">← Zpět na turnaje</a>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class="rounded-full bg-kostka-purple/10 px-3 py-1 text-xs font-semibold text-kostka-purple">
        {event.game}
      </span>
      <span class="text-xs font-semibold uppercase tracking-wide text-white/40">
        {event.type === "league" ? "Liga" : "Turnaj"}
      </span>
    </div>

    <h1 class="mt-3 text-3xl font-black text-white md:text-4xl">{event.title}</h1>
    <p class="mt-2 text-white/60">
      {event.date}{"time" in event ? ` · ${event.time}` : ""} · Dolní 782/65, Ostrava-Zábřeh
    </p>

    <div class="mt-10 grid gap-10 md:grid-cols-[1fr_320px]">
      <div class="prose prose-invert max-w-none text-white/70">
        <p>
          {isPast
            ? `Turnaj proběhl, zúčastnilo se ${("participants" in event) ? event.participants : ""} hráčů.`
            : "Přihlaste se na turnaj předem – ušetříte čas na místě. Účastnický poplatek se hradí až na místě před začátkem, platební brána se nepoužívá."}
        </p>
        {
          isPast && "winner" in event && (
            <p class="mt-4 flex items-center gap-2 rounded-xl bg-kostka-purple/10 p-4 font-semibold text-white">
              <img src="/images/icons/trophy.svg" alt="" class="h-5 w-5 flex-none" />
              Vítěz: {event.winner}
            </p>
          )
        }
      </div>

      {
        !isPast && showExternalRegistration && (
          <aside class="h-fit rounded-2xl border border-white/10 bg-kostka-surface p-6">
            <h2 class="font-bold text-white">Přihlášení přes PlayHub</h2>
            <p class="mt-1 text-sm text-white/50">
              Registrace na tento termín probíhá externě. Naše stránka pouze zobrazuje aktuální obsazenost a odkaz na event.
            </p>
            <div class="mt-4 rounded-xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between text-sm text-white/60">
                <span>Obsazenost</span>
                <span>{spotsTaken}/{spotsTotal}</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/10">
                <div class="h-full rounded-full bg-kostka-purple" style={`width: ${percentFull}%`} />
              </div>
              <p class="mt-3 text-sm text-white/70">Volných míst: {Math.max(spotsLeft, 0)}</p>
            </div>
            {"price" in event && event.price && (
              <p class="mt-3 text-sm font-semibold text-kostka-purple">Vstupné: {event.price} Kč</p>
            )}
            <a href={"registrationUrl" in event ? event.registrationUrl : "#"} target="_blank" rel="noreferrer" class="mt-5 inline-flex w-full items-center justify-center rounded-full bg-kostka-purple px-4 py-2.5 text-sm font-semibold text-kostka-bg hover:opacity-90">
              Otevřít PlayHub
            </a>
          </aside>
        )
      }
    </div>
  </section>
</Layout>
