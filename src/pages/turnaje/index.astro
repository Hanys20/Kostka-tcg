---
import Layout from "../../layouts/Layout.astro";
import TournamentCard from "../../components/tournaments/TournamentCard.astro";
import PastTournamentCard from "../../components/tournaments/PastTournamentCard.astro";
import ReservationCalendar from "../../components/tournaments/ReservationCalendar.astro";
import { getUpcomingTournaments, getPastTournaments } from "../../data/tournaments";

export const prerender = false;

const upcomingTournaments = await getUpcomingTournaments();
const pastTournaments = await getPastTournaments();
const upcomingLeague = upcomingTournaments.filter((e) => e.type === "league");
const upcomingTournamentOnly = upcomingTournaments.filter((e) => e.type === "tournament");
const activeTab = Astro.url.searchParams.get("tab") ?? "nadchazejici";
const tabHref = {
  nadchazejici: "/turnaje#nadchazejici",
  liga: "/turnaje#liga",
  turnaje: "/turnaje#turnaje",
  probihle: "/turnaje#probihle",
};
---

<Layout title="Turnaje a liga">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-black text-white md:text-4xl">Kalendář akcí</h1>

    <div class="mt-8 flex flex-wrap gap-2 border-b border-white/10 text-sm font-semibold">
      <a href={tabHref.nadchazejici} class:list={["px-1 pb-3", activeTab === "nadchazejici" ? "border-b-2 border-kostka-purple text-kostka-purple" : "text-white/50"]}>Nadcházející</a>
      <a href={tabHref.probihle} class:list={["px-1 pb-3", activeTab === "probihle" ? "border-b-2 border-kostka-purple text-kostka-purple" : "text-white/50"]}>Proběhlé</a>
      <a href={tabHref.liga} class:list={["px-1 pb-3", activeTab === "liga" ? "border-b-2 border-kostka-purple text-kostka-purple" : "text-white/50"]}>Liga</a>
      <a href={tabHref.turnaje} class:list={["px-1 pb-3", activeTab === "turnaje" ? "border-b-2 border-kostka-purple text-kostka-purple" : "text-white/50"]}>Turnaje</a>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3" data-filter-bar>
      <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Hra:</span>
      <div class="flex flex-wrap gap-2">
        {["Lorcana", "Pokémon", "Riftbound"].map((game) => (
          <button
            type="button"
            data-game-filter={game}
            data-active="true"
            class="rounded-full border border-white/10 px-3 py-1.5 text-xs font-semibold text-white/70 transition hover:border-kostka-purple data-[active=false]:border-white/10 data-[active=false]:text-white/30 data-[active=true]:border-kostka-purple data-[active=true]:bg-kostka-purple/10 data-[active=true]:text-kostka-purple"
          >
            {game}
          </button>
        ))}
      </div>
      <label class="ml-auto flex items-center gap-2 text-xs font-semibold text-white/70">
        <input type="checkbox" data-hide-full class="h-4 w-4 rounded border-white/20 bg-transparent accent-kostka-purple" />
        Skrýt obsazené
      </label>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[380px_1fr]">
      <ReservationCalendar />
      <div class="space-y-10">
        <div id="nadchazejici">
          <h2 id="liga" class="text-xl font-bold text-white">Liga (pravidelné hraní)</h2>
          <div class="mt-4 grid gap-6 sm:grid-cols-2" data-event-grid>
            {upcomingLeague.length ? upcomingLeague.map((event) => <TournamentCard event={event} />) : <p class="text-sm text-white/50">Zatím tu nejsou žádné termíny ligy.</p>}
          </div>
          <p class="mt-4 hidden text-sm text-white/50" data-empty-hint>Žádné termíny neodpovídají zvolenému filtru.</p>
        </div>
        <div id="turnaje">
          <h2 class="text-xl font-bold text-white">Turnaje a prerelease</h2>
          <div class="mt-4 grid gap-6 sm:grid-cols-2" data-event-grid>
            {upcomingTournamentOnly.length ? upcomingTournamentOnly.map((event) => <TournamentCard event={event} />) : <p class="text-sm text-white/50">Zatím tu nejsou žádné naplánované turnaje.</p>}
          </div>
          <p class="mt-4 hidden text-sm text-white/50" data-empty-hint>Žádné termíny neodpovídají zvolenému filtru.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const gameButtons = document.querySelectorAll<HTMLButtonElement>("[data-game-filter]");
    const hideFullCheckbox = document.querySelector<HTMLInputElement>("[data-hide-full]");
    const grids = document.querySelectorAll<HTMLElement>("[data-event-grid]");

    function applyFilters() {
      const activeGames = new Set(
        Array.from(gameButtons)
          .filter((btn) => btn.dataset.active === "true")
          .map((btn) => btn.dataset.gameFilter),
      );
      const hideFull = hideFullCheckbox?.checked ?? false;

      grids.forEach((grid) => {
        const cards = grid.querySelectorAll<HTMLElement>("[data-game]");
        let visibleCount = 0;

        cards.forEach((card) => {
          const matchesGame = activeGames.has(card.dataset.game);
          const isFull = card.dataset.full === "true";
          const shouldHide = !matchesGame || (hideFull && isFull);
          card.classList.toggle("hidden", shouldHide);
          if (!shouldHide) visibleCount += 1;
        });

        const emptyHint = grid.parentElement?.querySelector<HTMLElement>("[data-empty-hint]");
        if (emptyHint) {
          emptyHint.classList.toggle("hidden", cards.length === 0 || visibleCount > 0);
        }
      });
    }

    gameButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.dataset.active = btn.dataset.active === "true" ? "false" : "true";
        applyFilters();
      });
    });

    hideFullCheckbox?.addEventListener("change", applyFilters);

    applyFilters();
  </script>

  <section id="probihle" class="bg-kostka-surface/40 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Proběhlé turnaje</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pastTournaments.length ? pastTournaments.map((event) => <PastTournamentCard event={event} />) : <p class="text-sm text-white/50">Zatím tu nejsou žádné proběhlé turnaje.</p>}
      </div>
    </div>
  </section>
</Layout>
