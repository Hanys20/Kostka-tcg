---
import Layout from "../../layouts/Layout.astro";

const player = {
  name: "Jan Novák",
  nick: "JanTCG",
  email: "jan@email.cz",
  stats: { played: 12, wins: 7, losses: 4, draws: 1, best: "1. místo" },
};

const history = [
  { title: "Pokémon turnaj", date: "30. 7. 2026", result: "2. místo", record: "3V / 1P / 0R" },
  { title: "Lorcana liga", date: "18. 7. 2026", result: "5. místo", record: "2V / 2P / 1R" },
  { title: "Riftbound prerelease", date: "2. 7. 2026", result: "1. místo", record: "4V / 0P / 0R" },
];

const achievements = [
  { icon: "/images/icons/trophy.svg", text: "První výhra" },
  { icon: "/images/icons/fire.svg", text: "3 turnaje v řadě" },
  { icon: "/images/icons/cards_8531719.svg", text: "Prerelease veterán" },
];
---

<Layout title="Můj profil">
  <section class="mx-auto max-w-4xl px-4 py-16">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-black text-white md:text-4xl">{player.name}</h1>
        <p class="mt-1 text-white/50">@{player.nick} · {player.email}</p>
      </div>
      <a
        href="#nastaveni"
        class="rounded-full border border-white/15 px-5 py-2 text-sm font-semibold text-white hover:border-kostka-cyan hover:text-kostka-cyan"
      >
        Upravit profil
      </a>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-5">
      {
        [
          ["Odehráno", player.stats.played],
          ["Výhry", player.stats.wins],
          ["Prohry", player.stats.losses],
          ["Remízy", player.stats.draws],
          ["Nejlepší umístění", player.stats.best],
        ].map(([label, value]) => (
          <div class="rounded-2xl border border-white/10 bg-kostka-surface p-4 text-center">
            <p class="text-2xl font-black text-white">{value}</p>
            <p class="mt-1 text-xs text-white/50">{label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-bold text-white">Achievementy</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          achievements.map((a) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-kostka-cyan/10 px-4 py-1.5 text-sm font-semibold text-kostka-cyan">
              <img src={a.icon} alt="" class="h-4 w-4 flex-none" />
              {a.text}
            </span>
          ))
        }
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-bold text-white">Historie turnajů</h2>
      <div class="mt-3 overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full text-left text-sm">
          <thead class="bg-white/[0.03] text-white/50">
            <tr>
              <th class="px-4 py-3 font-semibold">Turnaj</th>
              <th class="px-4 py-3 font-semibold">Datum</th>
              <th class="px-4 py-3 font-semibold">Výsledek</th>
              <th class="px-4 py-3 font-semibold">Skóre</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {
              history.map((h) => (
                <tr>
                  <td class="px-4 py-3 font-medium text-white">{h.title}</td>
                  <td class="px-4 py-3 text-white/60">{h.date}</td>
                  <td class="px-4 py-3 text-white/60">{h.result}</td>
                  <td class="px-4 py-3 text-white/60">{h.record}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div id="nastaveni" class="mt-10 scroll-mt-24">
      <h2 class="text-xl font-bold text-white">Nastavení profilu</h2>
      <form class="mt-4 grid gap-4 sm:grid-cols-2">
        <input type="text" value={player.name} class="rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-cyan" />
        <input type="text" value={player.nick} class="rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-cyan" />
        <input type="email" value={player.email} class="rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white outline-none focus:border-kostka-cyan sm:col-span-2" />
        <button type="submit" class="rounded-full bg-kostka-cyan px-6 py-2.5 text-sm font-semibold text-kostka-bg hover:opacity-90 sm:w-fit">
          Uložit změny
        </button>
      </form>
    </div>
  </section>
</Layout>
