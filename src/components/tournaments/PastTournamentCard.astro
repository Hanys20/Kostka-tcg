---
import { gameBadgeColors, type PastTournamentEntry } from "../../data/tournaments";

interface Props {
  event: PastTournamentEntry;
}

const { event } = Astro.props;
---

<article class="flex flex-col rounded-2xl border border-kostka-dark/10 bg-kostka-dark/[0.03] p-5">
  <div class="flex items-center justify-between">
    <span class={`rounded-full px-3 py-1 text-xs font-semibold opacity-70 ${gameBadgeColors[event.game]}`}>
      {event.game}
    </span>
    <span class="text-xs font-semibold uppercase tracking-wide text-kostka-dark/40">
      {event.type === "league" ? "Liga" : "Turnaj"}
    </span>
  </div>

  <h3 class="mt-3 text-lg font-bold text-kostka-dark/80">{event.title}</h3>
  <p class="mt-1 text-sm text-kostka-dark/50">{event.date} · {event.participants} účastníků</p>

  <p class="mt-4 text-sm text-kostka-dark/70">
    🏆 Vítěz: <span class="font-semibold">{event.winner}</span>
  </p>

  <a
    href={`/turnaje/${event.slug}`}
    class="mt-5 inline-flex items-center justify-center rounded-full border border-kostka-dark/20 px-4 py-2 text-sm font-semibold text-kostka-dark/70 hover:border-kostka-cyan hover:text-kostka-cyan"
  >
    Zobrazit výsledky
  </a>
</article>
