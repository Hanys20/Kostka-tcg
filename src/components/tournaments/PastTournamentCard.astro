---
import { gameBadgeColors, type PastTournamentEntry } from "../../data/tournaments";

interface Props {
  event: PastTournamentEntry;
}

const { event } = Astro.props;
---

<article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-5">
  <div class="flex items-center justify-between">
    <span class={`rounded-full px-3 py-1 text-xs font-semibold opacity-70 ${gameBadgeColors[event.game]}`}>
      {event.game}
    </span>
    <span class="text-xs font-semibold uppercase tracking-wide text-white/40">
      {event.type === "league" ? "Liga" : "Turnaj"}
    </span>
  </div>

  <h3 class="mt-3 text-lg font-bold text-white/80">{event.title}</h3>
  <p class="mt-1 text-sm text-white/50">{event.date} · {event.participants} účastníků</p>

  <p class="mt-4 flex items-center gap-2 text-sm text-white/70">
    <img src="/images/icons/trophy.svg" alt="" class="h-4 w-4 flex-none" />
    Vítěz: <span class="font-semibold text-white">{event.winner}</span>
  </p>

  <a
    href={`/turnaje/${event.slug}`}
    class="mt-5 inline-flex items-center justify-center rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-white/70 hover:border-kostka-purple hover:text-kostka-purple"
  >
    Zobrazit výsledky
  </a>
</article>
