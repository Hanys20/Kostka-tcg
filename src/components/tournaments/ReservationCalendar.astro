---
import { getUpcomingTournaments } from "../../data/tournaments";

const MONTH_LABEL = "Srpen 2026";
const DAYS_IN_MONTH = 31;
const FIRST_WEEKDAY = 5;
const TODAY = 4;
const weekdayLabels = ["Po", "Út", "St", "Čt", "Pá", "So", "Ne"];

const upcomingTournaments = await getUpcomingTournaments();
const eventMap = new Map<number, (typeof upcomingTournaments)[number]>();
for (const event of upcomingTournaments) {
  eventMap.set(event.day, event);
}

const calendarPayload = JSON.stringify(
  upcomingTournaments.map((event) => ({
    day: event.day,
    title: event.title,
    slug: event.slug,
    registrationUrl: event.registrationUrl || `/turnaje/${event.slug}`,
  })),
);

const leadingBlanks = Array.from({ length: FIRST_WEEKDAY });
const days = Array.from({ length: DAYS_IN_MONTH }, (_, i) => i + 1);
---

<div class="rounded-2xl border border-white/10 bg-kostka-surface p-6" data-calendar-root>
  <div class="flex items-center justify-between">
    <p class="font-bold text-white">{MONTH_LABEL}</p>
    <div class="flex gap-1 text-white/40">
      <span class="grid h-7 w-7 place-items-center rounded-full border border-white/10">‹</span>
      <span class="grid h-7 w-7 place-items-center rounded-full border border-white/10">›</span>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-7 gap-1 text-center text-xs font-semibold text-white/40">
    {weekdayLabels.map((d) => <span>{d}</span>)}
  </div>

  <div class="mt-1 grid grid-cols-7 gap-1 text-center text-sm">
    {leadingBlanks.map(() => <span></span>)}
    {
      days.map((day) => {
        const event = eventMap.get(day);
        const isToday = day === TODAY;
        const textClasses = isToday ? "bg-kostka-cyan font-bold text-kostka-bg" : event ? "font-semibold text-kostka-cyan" : "text-white/70";

        return event ? (
          <a
            href={event.registrationUrl || `/turnaje/${event.slug}`}
            data-calendar-day={day}
            class:list={["relative grid h-9 place-items-center rounded-full transition hover:text-kostka-cyan", textClasses]}
            target={event.registrationUrl?.startsWith("http") ? "_blank" : undefined}
            rel={event.registrationUrl?.startsWith("http") ? "noreferrer" : undefined}
          >
            {day}
            <span class="absolute bottom-1 h-1 w-1 rounded-full bg-kostka-cyan" />
          </a>
        ) : (
          <span
            data-calendar-day={day}
            class:list={["relative grid h-9 place-items-center rounded-full", textClasses]}
          >
            {day}
          </span>
        );
      })
    }
  </div>

  <div class="mt-5 flex items-center gap-4 border-t border-white/10 pt-4 text-xs text-white/50">
    <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-kostka-cyan"></span> Volný termín</span>
    <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-white"></span> Dnes</span>
  </div>
</div>

<script is:inline>
  window.__KOSTKA_CALENDAR_EVENTS__ = window.__KOSTKA_CALENDAR_EVENTS__ || [];
  window.__KOSTKA_CALENDAR_EVENTS__ = [
    ...window.__KOSTKA_CALENDAR_EVENTS__,
    ...JSON.parse(`$${calendarPayload}`),
  ];
</script>
