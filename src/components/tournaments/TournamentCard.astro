---
import { gameBadgeColors, type TournamentEntry } from "../../data/tournaments";

interface Props {
  event: TournamentEntry;
}

const { event } = Astro.props;
const spotsLeft = event.spotsTotal - event.spotsTaken;
const percentFull = Math.round((event.spotsTaken / event.spotsTotal) * 100);
const actionHref = event.registrationUrl || `/turnaje/${event.slug}`;
const actionLabel = event.registrationUrl ? "Otevřít PlayHub" : spotsLeft > 0 ? "Rezervovat místo" : "Obsazeno – náhradník";
---

<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-kostka-surface p-5 transition-all duration-500 hover:-translate-y-0.5 hover:border-kostka-purple/40"
  data-game={event.game}
  data-full={spotsLeft <= 0}
>
  <div class="pointer-events-none absolute inset-0 rounded-2xl border border-transparent transition-all duration-500 group-hover:border-kostka-purple/70 group-hover:shadow-[0_0_0_1px_rgba(157,127,224,0.5),0_0_28px_rgba(157,127,224,0.35),0_0_56px_rgba(157,127,224,0.2)]"></div>
  <div class="relative flex items-center justify-between">
    <span class={`rounded-full px-3 py-1 text-xs font-semibold ${gameBadgeColors[event.game]}`}>
      {event.game}
    </span>
    <span class="text-xs font-semibold uppercase tracking-wide text-white/40">
      {event.type === "league" ? "Liga" : "Turnaj"}
    </span>
  </div>

  <h3 class="mt-3 text-lg font-bold text-white">{event.title}</h3>
  <p class="mt-1 text-sm text-white/50">{event.date} · {event.time}</p>

  <div class="mt-4">
    <div class="flex items-center justify-between text-xs text-white/40">
      <span>Obsazenost</span>
      <span>{event.spotsTaken}/{event.spotsTotal}</span>
    </div>
    <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
      <div class="h-full rounded-full bg-kostka-purple" style={`width: ${percentFull}%`}></div>
    </div>
  </div>

  <a
    href={actionHref}
    class="mt-5 inline-flex items-center justify-center rounded-full bg-kostka-purple px-4 py-2 text-sm font-semibold text-kostka-bg hover:opacity-90"
  >
    {actionLabel}
  </a>
</article>
