{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "kostka-tcg",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": true,
	"routes": [
		{ "pattern": "kostkatcg.cz", "custom_domain": true },
		{ "pattern": "www.kostkatcg.cz", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}